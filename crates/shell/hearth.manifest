<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="Hearth.Shell" version="1.0.0.0"/>
  <!-- Console plein écran à résolution fixe : l'affichage doit être identique quel que soit le
       réglage de mise à l'échelle de Windows, pas redimensionné par lui (dpiAware=false : Windows
       traite Hearth comme un programme non adapté au DPI et agrandit/réduit l'image lui-même en
       fonction de l'écran, au lieu de changer la taille logique de l'interface). -->
  <asmv3:application xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
    <asmv3:windowsSettings xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">
      <dpiAware>false</dpiAware>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
