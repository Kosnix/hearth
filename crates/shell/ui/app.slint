            border-radius: 46px;
            background: avrow == 3 ? Theme.accent : Theme.glass;
            Text {
                text: @tr("Valider");
                font-size: 30px;
                font-weight: 700;
                color: avrow == 3 ? Theme.on-accent : Theme.text;
            }
            TouchArea { clicked => { root.avrow = 3; root.avatar-pick(root.avsel); } }
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Valider"); }
            Hint { btn: 1; label: @tr("Retour"); }
        }
