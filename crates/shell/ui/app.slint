// Interface provisoire : tout le style passe par Theme.

export struct Tile {
    name: string,
    cover: image,
    running: bool,
}

export global Theme {
    out property <color> bg: #0b0d12;
    out property <color> panel: #161a22e6;
    out property <color> panel-solid: #161a22;
    out property <color> tile: #222834;
    out property <color> accent: #4c8dff;
    out property <color> text: #f2f4f8;
    out property <color> dim: #9aa3b2;
    out property <string> icons: "Segoe MDL2 Assets";
    out property <length> tile-w: 220px;
    out property <length> tile-h: 330px;
    out property <length> gap: 24px;
}

component GameTile inherits Rectangle {
    in property <Tile> tile;
    in property <bool> selected;
    callback clicked;
    width: Theme.tile-w;
    height: Theme.tile-h;
    border-radius: 10px;
    clip: true;
    background: Theme.tile;
    Image {
        width: 100%;
        height: 100%;
        source: tile.cover;
        image-fit: cover;
    }
    if tile.cover.width == 0: Text {
        width: parent.width - 24px;
        text: tile.name;
        color: Theme.text;
        font-size: 22px;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    if tile.running: Rectangle {
        x: 10px;
        y: 10px;
        width: badge.preferred-width + 16px;
        height: 28px;
        border-radius: 14px;
        background: Theme.accent;
        badge := Text {
            text: "En cours";
            font-size: 14px;
            color: Theme.text;
        }
    }
    Rectangle {
        border-radius: 10px;
        border-width: selected ? 4px : 0px;
        border-color: Theme.accent;
        animate border-width { duration: 100ms; }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

component SysButton inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: selected ? Theme.accent : Theme.panel;
    Text {
        text: glyph;
        font-family: Theme.icons;
        font-size: 28px;
        color: Theme.text;
    }
    Text {
        y: parent.height + 8px;
        text: label;
        font-size: 16px;
        color: selected ? Theme.text : Theme.dim;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Clavier (debug) -> mêmes actions que la manette.
component NavKeys inherits FocusScope {
    callback nav(int);
    key-pressed(e) => {
        if (e.text == Key.UpArrow) { root.nav(0); return accept; }
        if (e.text == Key.DownArrow) { root.nav(1); return accept; }
        if (e.text == Key.LeftArrow) { root.nav(2); return accept; }
        if (e.text == Key.RightArrow) { root.nav(3); return accept; }
        if (e.text == Key.Return) { root.nav(4); return accept; }
        if (e.text == Key.Escape) { root.nav(5); return accept; }
        if (e.text == Key.Home) { root.nav(6); return accept; }
        reject
    }
}

export component App inherits Window {
    in property <[Tile]> games;
    in-out property <int> sel: 0;
    in-out property <int> zone: 0; // 0 jeux, 1 barre système, 2 menu alimentation
    in-out property <int> sys: 0;
    in-out property <int> pw: 0;
    callback launch(int);
    callback power(int); // 0 veille, 1 redémarrer, 2 éteindre
    callback desktop();

    title: "Hearth";
    no-frame: true;
    background: Theme.bg;
    preferred-width: 1280px;
    preferred-height: 720px;
    forward-focus: keys;

    // a : 0 haut, 1 bas, 2 gauche, 3 droite, 4 valider, 5 retour, 6 guide, 7 menu (cf. input::Nav)
    public function nav(a: int) {
        if (a == 6) {
            zone = 0;
        } else if (zone == 2) {
            if (a == 0) { pw = max(0, pw - 1); }
            else if (a == 1) { pw = min(3, pw + 1); }
            else if (a == 5 || (a == 4 && pw == 3)) { zone = 1; }
            else if (a == 4) { power(pw); }
        } else if (zone == 1) {
            if (a == 2) { sys = max(0, sys - 1); }
            else if (a == 3) { sys = min(2, sys + 1); }
            else if (a == 0 || a == 5) { zone = 0; }
            else if (a == 4 && sys == 1) { desktop(); }
            else if (a == 4 && sys == 2) { pw = 0; zone = 2; }
        } else if (games.length > 0 || a == 1) {
            if (a == 2) { sel = max(0, sel - 1); }
            else if (a == 3) { sel = min(games.length - 1, sel + 1); }
            else if (a == 1) { zone = 1; }
            else if (a == 4) { launch(sel); }
        }
    }

    keys := NavKeys {
        nav(a) => { root.nav(a); }
    }

    // Fond dynamique : jaquette du jeu sélectionné.
    if games.length > 0: Image {
        width: 100%;
        height: 100%;
        source: games[sel].cover;
        image-fit: cover;
        opacity: 0.45;
    }
    Rectangle {
        background: @linear-gradient(180deg, #0b0d1200 0%, #0b0d12 85%);
    }

    Text {
        x: 80px;
        y: parent.height - Theme.tile-h - 230px;
        text: games.length > 0 ? games[sel].name : "Aucun jeu";
        font-size: 40px;
        font-weight: 600;
        color: Theme.text;
    }

    Rectangle {
        x: 80px - sel * (Theme.tile-w + Theme.gap);
        y: parent.height - Theme.tile-h - 160px;
        width: games.length * (Theme.tile-w + Theme.gap);
        height: Theme.tile-h;
        animate x { duration: 150ms; easing: ease-out; }
        for t[i] in games: GameTile {
            x: i * (Theme.tile-w + Theme.gap);
            y: zone == 0 && i == sel ? -12px : 0px;
            animate y { duration: 100ms; }
            tile: t;
            selected: zone == 0 && i == sel;
            clicked => {
                root.sel = i;
                root.zone = 0;
                root.launch(i);
            }
        }
    }

    Rectangle {
        width: 3 * 72px + 2 * 40px;
        height: 72px;
        y: parent.height - 120px;
        for b[i] in [
            { glyph: "\u{E713}", label: "Réglages" },
            { glyph: "\u{E7F4}", label: "Bureau" },
            { glyph: "\u{E7E8}", label: "Alimentation" },
        ]: SysButton {
            x: i * (72px + 40px);
            glyph: b.glyph;
            label: b.label;
            selected: zone == 1 && i == sys;
            clicked => {
                root.zone = 1;
                root.sys = i;
                root.nav(4);
            }
        }
    }

    if zone == 2: Rectangle {
        background: #000a;
        TouchArea { }
        Rectangle {
            width: 360px;
            height: 4 * 64px + 24px;
            border-radius: 16px;
            background: Theme.panel;
            for item[i] in ["Mettre en veille", "Redémarrer", "Éteindre", "Annuler"]: Rectangle {
                x: 16px;
                y: 16px + i * 64px;
                width: parent.width - 32px;
                height: 56px;
                border-radius: 10px;
                background: i == pw ? Theme.accent : transparent;
                Text {
                    text: item;
                    font-size: 22px;
                    color: Theme.text;
                }
                TouchArea {
                    clicked => {
                        root.pw = i;
                        root.nav(4);
                    }
                }
            }
        }
    }
}

// Menu guide : panneau latéral affiché par-dessus le jeu.
export component GuideMenu inherits Window {
    in property <string> game;
    in property <bool> closing;
    in property <int> volume: -1; // %, -1 = indisponible
    in property <int> brightness: -1;
    in property <int> wifi: -1; // -1 indisponible, 0 coupé, 1 actif
    in property <[string]> notes;
    in-out property <int> sel: 0;
    // item (0 reprendre, 1 accueil, 2 fermer, 3 volume, 4 luminosité, 5 wifi ; -1 = fermer le menu),
    // delta : 0 valider, -1/+1 gauche/droite
    callback action(int, int);

    title: "Hearth Guide";
    no-frame: true;
    always-on-top: true;
    background: Theme.panel-solid;
    forward-focus: keys;

    public function nav(a: int) {
        if (a == 0) { sel = max(0, sel - 1); }
        else if (a == 1) { sel = min(5, sel + 1); }
        else if (a == 2) { action(sel, -1); }
        else if (a == 3) { action(sel, 1); }
        else if (a == 4) { action(sel, 0); }
        else if (a == 5 || a == 6) { action(-1, 0); }
    }

    keys := NavKeys {
        nav(a) => { root.nav(a); }
    }

    VerticalLayout {
        padding: 32px;
        spacing: 10px;
        Text {
            text: game;
            font-size: 28px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        Rectangle { height: 12px; }
        for item[i] in [
            "Reprendre",
            "Accueil",
            closing ? "Forcer la fermeture" : "Fermer le jeu",
            "Volume  ‹ " + (volume < 0 ? "—" : volume + " %") + " ›",
            "Luminosité  ‹ " + (brightness < 0 ? "—" : brightness + " %") + " ›",
            "Wi-Fi : " + (wifi < 0 ? "—" : wifi == 1 ? "activé" : "coupé"),
        ]: Rectangle {
            height: 56px;
            border-radius: 10px;
            background: i == sel ? Theme.accent : transparent;
            Text {
                x: 16px;
                text: item;
                font-size: 20px;
                color: Theme.text;
            }
            TouchArea {
                clicked => {
                    root.sel = i;
                    root.action(i, 0);
                }
            }
        }
        Rectangle { }
        Text {
            text: "Notifications";
            font-size: 16px;
            color: Theme.dim;
        }
        for n in notes: Text {
            text: n;
            font-size: 15px;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
}
