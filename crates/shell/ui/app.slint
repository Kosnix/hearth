                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.move) { root.msel = i; }
                    }
                }
            }
        }
    }

    if zone == 2: Rectangle {
        background: #000a;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
            }
        }
        Rectangle {
            width: 460px;
            height: 5 * 76px + 32px;
            border-radius: 20px;
            background: Theme.panel;
            for item[i] in [@tr("Mettre en veille"), @tr("Redémarrer"), @tr("Éteindre"), @tr("Bureau Windows"), @tr("Annuler")]: Rectangle {
                x: 16px;
                y: 16px + i * 76px;
                width: parent.width - 32px;
                height: 68px;
                border-radius: 14px;
                background: i == pw ? Theme.accent : transparent;
                Text {
                    x: 24px;
                    text: item;
                    font-size: 28px;
                    color: i == pw ? Theme.on-accent : Theme.text;
                }
                TouchArea {
                    clicked => {
                        root.pw = i;
                        root.nav(4);
                    }
                }
            }
        }
    }

    if zone == 3: Rectangle {
        background: Theme.bg-settings;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
            }
        }
        Text {
            x: 80px;
            y: 100px;
            text: @tr("Réglages");
            font-size: 64px;
            font-weight: 800;
