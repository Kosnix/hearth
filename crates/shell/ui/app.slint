// Direction visuelle : docs/design.md. Tout le style passe par Theme.

export struct Tile {
    name: string,
    cover: image,
    running: bool,
}

export struct SettingRow {
    label: string,
    value: string,
    adjustable: bool,
}

export global Theme {
    out property <brush> bg: @linear-gradient(180deg, #3d5a99 0%, #2a2166 100%);
    out property <brush> bg-settings: @linear-gradient(180deg, #34508f 0%, #231b5a 100%);
    out property <color> panel: #1b2142ee;
    out property <color> panel-solid: #1b2142;
    out property <color> glass: #ffffff1f;
    out property <color> tile: #2b3566;
    out property <color> accent: #3d7bff;
    out property <color> text: #ffffff;
    out property <color> dim: #c3cae6;
    out property <string> icons: "Segoe MDL2 Assets";
    out property <length> tile-w: 400px;
    out property <length> tile-h: 225px;
    out property <length> gap: 32px;
}

component GameTile inherits Rectangle {
    in property <Tile> tile;
    in property <bool> selected;
    callback clicked;
    width: Theme.tile-w;
    height: Theme.tile-h;
    Rectangle {
        border-radius: 12px;
        clip: true;
        background: Theme.tile;
        Image {
            width: 100%;
            height: 100%;
            source: tile.cover;
            image-fit: cover;
        }
        if tile.cover.width == 0: Text {
            width: parent.width - 32px;
            text: tile.name;
            color: Theme.text;
            font-size: 30px;
            font-weight: 600;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if tile.running: Rectangle {
            x: 12px;
            y: 12px;
            width: badge.preferred-width + 20px;
            height: 32px;
            border-radius: 16px;
            background: Theme.accent;
            badge := Text {
                text: "En cours";
                font-size: 16px;
                color: Theme.text;
            }
        }
        Rectangle {
            border-radius: 12px;
            border-width: selected ? 5px : 0px;
            border-color: Theme.accent;
            animate border-width { duration: 100ms; }
        }
    }
    Text {
        y: parent.height + 16px;
        text: tile.name;
        font-size: 24px;
        color: selected ? Theme.text : Theme.dim;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Grande tuile de la rangée de navigation du bas.
component NavTile inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;
    width: selected ? 224px : 200px;
    height: selected ? 168px : 150px;
    y: selected ? -12px : 0px;
    border-radius: 12px;
    background: selected ? Theme.accent : Theme.glass;
    animate width, height, y, background { duration: 120ms; }
    Text {
        y: 28px;
        text: glyph;
        font-family: Theme.icons;
        font-size: 56px;
        color: Theme.text;
        x: (parent.width - self.width) / 2;
    }
    Text {
        y: parent.height - 44px;
        text: label;
        font-size: 22px;
        color: selected ? Theme.text : Theme.dim;
        x: (parent.width - self.width) / 2;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Clavier (debug) -> mêmes actions que la manette.
component NavKeys inherits FocusScope {
    callback nav(int);
    key-pressed(e) => {
        if (e.text == Key.UpArrow) { root.nav(0); return accept; }
        if (e.text == Key.DownArrow) { root.nav(1); return accept; }
        if (e.text == Key.LeftArrow) { root.nav(2); return accept; }
        if (e.text == Key.RightArrow) { root.nav(3); return accept; }
        if (e.text == Key.Return) { root.nav(4); return accept; }
        if (e.text == Key.Escape) { root.nav(5); return accept; }
        if (e.text == Key.Home) { root.nav(6); return accept; }
        reject
    }
}

export component App inherits Window {
    in property <[Tile]> games;
    in property <string> user: "Joueur";
    in property <string> clock;
    in property <[string]> cats;
    in property <[SettingRow]> rows;
    in property <string> shint;
    in-out property <int> sel: 0;
    in-out property <int> zone: 0; // 0 jeux, 1 barre système, 2 menu alimentation, 3 réglages
    in-out property <int> sys: 0;
    in-out property <int> pw: 0;
    in-out property <int> cat: 0;
    in-out property <int> srow: 0;
    in-out property <int> sfocus: 0; // 0 catégories, 1 lignes
    callback launch(int);
    callback power(int); // 0 veille, 1 redémarrer, 2 éteindre
    callback desktop();
    callback open-cat(int);
    callback setting(int, int, int); // catégorie, ligne, delta (0 valider, -1/+1 ajuster)

    title: "Hearth";
    no-frame: true;
    background: #2a2166;
    preferred-width: 1280px;
    preferred-height: 720px;
    forward-focus: keys;

    // a : 0 haut, 1 bas, 2 gauche, 3 droite, 4 valider, 5 retour, 6 guide, 7 menu (cf. input::Nav)
    public function nav(a: int) {
        if (a == 6) {
            zone = 0;
        } else if (zone == 3) {
            if (sfocus == 0) {
                if (a == 0 && cat > 0) { cat = cat - 1; srow = 0; open-cat(cat); }
                else if (a == 1 && cat < cats.length - 1) { cat = cat + 1; srow = 0; open-cat(cat); }
                else if ((a == 3 || a == 4) && rows.length > 0) { sfocus = 1; }
                else if (a == 5) { zone = 1; }
            } else {
                if (a == 0) { srow = max(0, srow - 1); }
                else if (a == 1) { srow = min(rows.length - 1, srow + 1); }
                else if (a == 2) { if (rows[srow].adjustable) { setting(cat, srow, -1); } else { sfocus = 0; } }
                else if (a == 3) { if (rows[srow].adjustable) { setting(cat, srow, 1); } }
                else if (a == 4) { setting(cat, srow, 0); }
                else if (a == 5) { sfocus = 0; }
            }
        } else if (zone == 2) {
            if (a == 0) { pw = max(0, pw - 1); }
            else if (a == 1) { pw = min(3, pw + 1); }
            else if (a == 5 || (a == 4 && pw == 3)) { zone = 1; }
            else if (a == 4) { power(pw); }
        } else if (zone == 1) {
            if (a == 2) { sys = max(0, sys - 1); }
            else if (a == 3) { sys = min(2, sys + 1); }
            else if (a == 0 || a == 5) { zone = 0; }
            else if (a == 4 && sys == 0) { sfocus = 0; srow = 0; zone = 3; open-cat(cat); }
            else if (a == 4 && sys == 1) { desktop(); }
            else if (a == 4 && sys == 2) { pw = 0; zone = 2; }
        } else if (games.length > 0 || a == 1) {
            if (a == 2) { sel = max(0, sel - 1); }
            else if (a == 3) { sel = min(games.length - 1, sel + 1); }
            else if (a == 1) { zone = 1; }
            else if (a == 4) { launch(sel); }
        }
    }

    keys := NavKeys {
        nav(a) => { root.nav(a); }
    }

    Rectangle {
        background: Theme.bg;
    }

    // En-tête : profil à gauche, Wi-Fi et heure à droite.
    Rectangle {
        x: 80px;
        y: 48px;
        width: 56px;
        height: 56px;
        border-radius: 28px;
        background: Theme.glass;
        Text {
            text: "\u{E77B}";
            font-family: Theme.icons;
            font-size: 28px;
            color: Theme.text;
        }
    }
    Text {
        x: 152px;
        y: 62px;
        text: user;
        font-size: 26px;
        color: Theme.text;
    }
    Text {
        x: parent.width - self.width - 80px;
        y: 62px;
        text: clock;
        font-size: 26px;
        color: Theme.text;
    }
    Text {
        x: parent.width - 80px - 120px - self.width;
        y: 62px;
        text: "\u{E701}";
        font-family: Theme.icons;
        font-size: 26px;
        color: Theme.text;
    }

    Text {
        x: 80px;
        y: 250px;
        text: "Jeux";
        font-size: 96px;
        font-weight: 800;
        color: Theme.text;
    }

    if games.length == 0: Text {
        x: 80px;
        y: 480px;
        text: "Aucun jeu";
        font-size: 32px;
        color: Theme.dim;
    }

    Rectangle {
        x: 80px - sel * (Theme.tile-w + Theme.gap);
        y: 460px;
        width: games.length * (Theme.tile-w + Theme.gap);
        height: Theme.tile-h + 60px;
        animate x { duration: 150ms; easing: ease-out; }
        for t[i] in games: GameTile {
            x: i * (Theme.tile-w + Theme.gap);
            y: zone == 0 && i == sel ? -14px : 0px;
            animate y { duration: 100ms; }
            tile: t;
            selected: zone == 0 && i == sel;
            clicked => {
                root.sel = i;
                root.zone = 0;
                root.launch(i);
            }
        }
    }

    Rectangle {
        x: 80px;
        y: parent.height - 260px;
        width: 3 * 224px + 2 * 32px;
        height: 168px;
        for b[i] in [
            { glyph: "\u{E713}", label: "Réglages" },
            { glyph: "\u{E7F4}", label: "Bureau" },
            { glyph: "\u{E7E8}", label: "Alimentation" },
        ]: NavTile {
            x: i * (224px + 32px) + (224px - self.width) / 2;
            glyph: b.glyph;
            label: b.label;
            selected: zone == 1 && i == sys;
            clicked => {
                root.zone = 1;
                root.sys = i;
                root.nav(4);
            }
        }
    }

    if zone == 2: Rectangle {
        background: #000a;
        TouchArea { }
        Rectangle {
            width: 400px;
            height: 4 * 72px + 32px;
            border-radius: 16px;
            background: Theme.panel;
            for item[i] in ["Mettre en veille", "Redémarrer", "Éteindre", "Annuler"]: Rectangle {
                x: 16px;
                y: 16px + i * 72px;
                width: parent.width - 32px;
                height: 64px;
                border-radius: 12px;
                background: i == pw ? Theme.accent : transparent;
                Text {
                    text: item;
                    font-size: 26px;
                    color: Theme.text;
                }
                TouchArea {
                    clicked => {
                        root.pw = i;
                        root.nav(4);
                    }
                }
            }
        }
    }

    if zone == 3: Rectangle {
        background: Theme.bg-settings;
        TouchArea { }
        Text {
            x: 80px;
            y: 100px;
            text: "Réglages";
            font-size: 96px;
            font-weight: 800;
            color: Theme.text;
        }
        for c[i] in cats: Rectangle {
            x: 80px;
            y: 300px + i * 96px;
            width: 440px;
            height: 80px;
            border-radius: 12px;
            background: i != cat ? transparent : sfocus == 0 ? Theme.accent : Theme.glass;
            animate background { duration: 100ms; }
            Text {
                x: 28px;
                text: c;
                font-size: 28px;
                color: i == cat ? Theme.text : Theme.dim;
            }
            TouchArea {
                clicked => {
                    root.cat = i;
                    root.sfocus = 0;
                    root.srow = 0;
                    root.open-cat(i);
                }
            }
        }
        Rectangle {
            x: 580px;
            y: 300px;
            width: parent.width - 580px - 80px;
            height: rows.length * 104px + 24px;
            border-radius: 16px;
            background: Theme.glass;
            for r[i] in rows: Rectangle {
                x: 12px;
                y: 12px + i * 104px;
                width: parent.width - 24px;
                height: 96px;
                border-radius: 12px;
                background: sfocus == 1 && i == srow ? Theme.accent : transparent;
                animate background { duration: 100ms; }
                Text {
                    x: 32px;
                    text: r.label;
                    font-size: 28px;
                    color: Theme.text;
                }
                Text {
                    x: parent.width - self.width - 32px;
                    text: r.adjustable ? "‹  " + r.value + "  ›" : r.value;
                    font-size: 28px;
                    color: sfocus == 1 && i == srow ? Theme.text : Theme.dim;
                }
                TouchArea {
                    clicked => {
                        root.sfocus = 1;
                        root.srow = i;
                        root.setting(root.cat, i, 0);
                    }
                }
            }
        }
        Text {
            x: 580px;
            y: 300px + rows.length * 104px + 56px;
            text: shint;
            font-size: 24px;
            color: Theme.text;
        }
        Text {
            x: 80px;
            y: parent.height - 90px;
            text: "A  Valider      B  Retour      ◀ ▶  Ajuster";
            font-size: 22px;
            color: Theme.dim;
        }
    }
}

// Menu guide : panneau latéral affiché par-dessus le jeu.
export component GuideMenu inherits Window {
    in property <string> game;
    in property <bool> closing;
    in property <int> volume: -1; // %, -1 = indisponible
    in property <int> brightness: -1;
    in property <int> wifi: -1; // -1 indisponible, 0 coupé, 1 actif
    in property <[string]> notes;
    in-out property <int> sel: 0;
    // item (0 reprendre, 1 accueil, 2 fermer, 3 volume, 4 luminosité, 5 wifi ; -1 = fermer le menu),
    // delta : 0 valider, -1/+1 gauche/droite
    callback action(int, int);

    title: "Hearth Guide";
    no-frame: true;
    always-on-top: true;
    background: Theme.panel-solid;
    forward-focus: keys;

    public function nav(a: int) {
        if (a == 0) { sel = max(0, sel - 1); }
        else if (a == 1) { sel = min(5, sel + 1); }
        else if (a == 2) { action(sel, -1); }
        else if (a == 3) { action(sel, 1); }
        else if (a == 4) { action(sel, 0); }
        else if (a == 5 || a == 6) { action(-1, 0); }
    }

    keys := NavKeys {
        nav(a) => { root.nav(a); }
    }

    VerticalLayout {
        padding: 32px;
        spacing: 10px;
        Text {
            text: game;
            font-size: 28px;
            font-weight: 600;
            color: Theme.text;
            wrap: word-wrap;
        }
        Rectangle { height: 12px; }
        for item[i] in [
            "Reprendre",
            "Accueil",
            closing ? "Forcer la fermeture" : "Fermer le jeu",
            "Volume  ‹ " + (volume < 0 ? "—" : volume + " %") + " ›",
            "Luminosité  ‹ " + (brightness < 0 ? "—" : brightness + " %") + " ›",
            "Wi-Fi : " + (wifi < 0 ? "—" : wifi == 1 ? "activé" : "coupé"),
        ]: Rectangle {
            height: 56px;
            border-radius: 10px;
            background: i == sel ? Theme.accent : transparent;
            Text {
                x: 16px;
                text: item;
                font-size: 20px;
                color: Theme.text;
            }
            TouchArea {
                clicked => {
                    root.sel = i;
                    root.action(i, 0);
                }
            }
        }
        Rectangle { }
        Text {
            text: "Notifications";
            font-size: 16px;
            color: Theme.dim;
        }
        for n in notes: Text {
            text: n;
            font-size: 15px;
            color: Theme.text;
            wrap: word-wrap;
        }
    }
}
