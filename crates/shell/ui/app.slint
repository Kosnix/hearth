                }
            }
            Text {
                x: 130px;
                text: p.name;
                font-size: 34px;
                font-weight: 600;
                color: i == pfsel ? Theme.on-accent : Theme.text;
            }
            if p.active: Text {
                x: parent.width - self.width - 36px;
                text: @tr("Profil actif");
                font-size: 26px;
                color: i == pfsel ? Theme.on-accent : Theme.text;
            }
            TouchArea {
                clicked => { root.pfsel = i; root.profile-pick(i); }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.move) { root.pfsel = i; }
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.profile-menu(i); }
                }
            }
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Valider"); }
            Hint { btn: 1; label: @tr("Retour"); }
            Hint { btn: 3; label: @tr("Options"); }
        }
    }

    if zone == 12: Rectangle {
        background: Theme.bg-settings;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
            }
        }
        Text {
            x: 80px;
            y: 100px;
            text: @tr("Photo de profil");
            font-size: 60px;
            font-weight: 800;
            color: Theme.text;
        }
        Avatar {
            x: 160px;
            y: 330px;
            kind: avsel;
            photo: av-photo;
            size: 420px;
        }
        Text {
            x: 160px;
            y: 780px;
            width: 420px;
            text: user;
            horizontal-alignment: center;
            font-size: 40px;
            font-weight: 700;
