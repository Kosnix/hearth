        }
        for c[i] in cats: Rectangle {
            x: 80px;
            y: 250px + i * 76px;
            width: 440px;
            height: 64px;
            border-radius: 14px;
            background: i != cat ? transparent : sfocus == 0 ? Theme.accent : Theme.glass;
            animate background { duration: 100ms; }
            Text {
                x: 26px;
                text: ["\u{E767}", "\u{E7F4}", "\u{E701}", "\u{E702}", "\u{E7FC}", "\u{E774}", "\u{E895}", "\u{EDA2}", "\u{E950}", "\u{E7E8}", "\u{E7ED}", "\u{E946}", "\u{E77B}", "\u{E790}"][i];
                font-family: Theme.icons;
                font-size: 28px;
                color: i == cat ? (sfocus == 0 ? Theme.on-accent : Theme.text) : Theme.dim;
            }
            Text {
                x: 84px;
                text: c;
                font-size: 28px;
                color: i == cat ? (sfocus == 0 ? Theme.on-accent : Theme.text) : Theme.dim;
            }
            TouchArea {
                clicked => {
                    root.cat = i;
                    root.sfocus = 0;
                    root.srow = 0;
                    root.open-cat(i);
                }
            }
        }
        Rectangle {
            x: 580px;
            y: 300px;
            width: parent.width - 580px - 80px;
            height: min(rows.length, 8) * 104px + 24px;
            clip: true;
            border-radius: 18px;
            background: Theme.glass;
            for r[i] in rows: Rectangle {
                x: 12px;
                y: 12px + (i - max(0, srow - 7)) * 104px;
                width: parent.width - 24px;
                height: 96px;
                border-radius: 14px;
                background: sfocus == 1 && i == srow ? Theme.accent : transparent;
                animate background { duration: 100ms; }
                Text {
                    x: 32px;
                    text: r.label;
                    font-size: 28px;
                    color: sfocus == 1 && i == srow ? Theme.on-accent : Theme.text;
                }
                Text {
                    x: parent.width - self.width - 32px;
                    text: r.adjustable ? "‹  " + r.value + "  ›" : r.value;
                    font-size: 28px;
                    color: sfocus == 1 && i == srow ? Theme.on-accent : Theme.dim;
                }
                TouchArea {
                    clicked => {
                        root.sfocus = 1;
                        root.srow = i;
                        root.setting(root.cat, i, 0);
                    }
                }
            }
        }
        Text {
            x: 580px;
            y: 300px + min(rows.length, 8) * 104px + 56px;
            text: shint;
            font-size: 24px;
            color: Theme.text;
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Valider"); }
            Hint { btn: 1; label: @tr("Retour"); }
        }
