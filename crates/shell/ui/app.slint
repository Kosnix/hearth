// Direction visuelle : docs/design.md (thème bleu conservé) ; squelette d'accueil façon PS5.
// Les textes sont en français (langue source) et traduits par @tr (dossier lang/).

import { ListView } from "std-widgets.slint";

export struct Tile {
    gid: int,
    store: string,
    played: string,
    lastp: string,
    name: string,
    initial: string,
    hue: color,
    cover: image,
    hero: image,
    logo: image,
    running: bool,
    install: bool,
    sub: string,
}

export struct ProfileRow {
    name: string,
    avatar: int,
    photo: image,
    active: bool,
    add: bool,
}

export struct DlRow {
    name: string,
    status: string,
    pct: int,
    kind: int,
    cancel: bool,
}

export struct Deal {
    store: string,
    price: string,
}

export struct SettingRow {
    label: string,
    value: string,
    adjustable: bool,
}

export struct Notif {
    title: string,
    text: string,
    time: string,
    unread: bool,
}

export struct PickItem {
    label: string,
    sub: string,
    glyph: string,
    art: image,
}

export struct Offer {
    title: string,
    price: string,
    store: string,
    art: image,
    owned: bool,
    initial: string,
}

export global Theme {
    // Jetons de couleur : renseignés par le shell (thème personnalisable, voir theme.rs) ; valeurs ci-dessous = thème par défaut.
    in-out property <color> bg: #1b1b1d;
    in-out property <color> bg-settings: #1b1b1d;
    in-out property <color> bg-guide: #202022;
    in-out property <color> deep: #0d0d0f;
    in-out property <color> band: #262628;
    in-out property <color> on-accent: #111111;
    in-out property <color> panel: #262628f2;
    in-out property <color> glass: #ffffff14;
    in-out property <color> tile: #2b2b2e;
    in-out property <color> accent: #ffa500;
    in-out property <color> text: #ffffff;
    in-out property <color> dim: #b4b4b9;
    in-out property <color> ok: #4fd18f;
    in-out property <color> danger: #ff5b5b;
    out property <string> icons: "Segoe MDL2 Assets";
}

// Dernière manette utilisée : 0 Xbox/générique, 1 PlayStation (renseigné par le shell).
export global Pad {
    in-out property <int> kind: 0;
}

// Pictogramme d'un bouton de manette. btn : 0 valider, 1 retour, 2 guide, 3 menu.
component PadGlyph inherits Rectangle {
    in property <int> btn;
    property <bool> ps: Pad.kind == 1;
    width: 48px;
    height: 48px;
    // Cercle fin blanc, symbole ou lettre à l'intérieur (comme dans le thème FireLike).
    Rectangle {
        border-radius: 24px;
        border-width: 2px;
        border-color: #ffffffd0;
    }
    if ps && btn == 0: Path {
        width: 48px;
        height: 48px;
        viewbox-width: 48;
        viewbox-height: 48;
        commands: "M 17 17 L 31 31 M 31 17 L 17 31";
        stroke: #ffffffd0;
        stroke-width: 3px;
        stroke-line-cap: round;
    }
    if ps && btn == 1: Rectangle {
        x: 15px;
        y: 15px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        border-width: 3px;
        border-color: #ffffffd0;
    }
    if ps && btn == 2: Text {
        text: "PS";
        font-size: 16px;
        font-weight: 900;
        color: #ffffffd0;
    }
    if !ps && btn <= 1: Text {
        text: btn == 0 ? "A" : "B";
        font-size: 24px;
        font-weight: 600;
        color: #ffffffd0;
    }
    if !ps && btn == 2: Text {
        text: "\u{E7FC}";
        font-family: Theme.icons;
        font-size: 22px;
        color: #ffffffd0;
    }
    if btn == 4 && ps: Path {
        width: 48px;
        height: 48px;
        viewbox-width: 48;
        viewbox-height: 48;
        commands: "M 24 14 L 33 30 L 15 30 Z";
        stroke: #ffffffd0;
        stroke-width: 3px;
        stroke-line-join: round;
    }
    if btn == 4 && !ps: Text {
        text: "Y";
        font-size: 24px;
        font-weight: 600;
        color: #ffffffd0;
    }
    if btn == 5: Text {
        text: "L3+R3";
        font-size: 13px;
        font-weight: 700;
        color: #ffffffd0;
    }
    if btn == 3: Path {
        width: 48px;
        height: 48px;
        viewbox-width: 48;
        viewbox-height: 48;
        commands: "M 15 17 L 33 17 M 15 24 L 33 24 M 15 31 L 33 31";
        stroke: #ffffffd0;
        stroke-width: 3px;
        stroke-line-cap: round;
    }
}

component Hint inherits Rectangle {
    in property <int> btn;
    in property <string> label;
    width: 64px + lbl.preferred-width;
    height: 48px;
    PadGlyph {
        x: 0px;
        btn: root.btn;
    }
    lbl := Text {
        x: 64px;
        text: label;
        font-size: 28px;
        y: (parent.height - self.height) / 2;
        color: Theme.text;
    }
}

// Avatar généré : dégradé de couleur + emblème (6 teintes x 4 emblèmes = 24 avatars).
component Avatar inherits Rectangle {
    in property <int> kind; // emblème * 12 + couleur
    in property <image> photo;
    in property <length> size: 72px;
    width: size;
    height: size;
    border-radius: size / 2;
    clip: true;
    property <color> c: [#e5484d, #f5a524, #2dc98a, #3aa0ff, #9b6bff, #ff5fa2, #22c5d8, #8bc34a, #ff7a45, #7c8cff, #c0c6d4, #d4a373][mod(kind, 12)];
    background: @linear-gradient(160deg, c.brighter(0.3) 0%, c.darker(0.6) 100%);
    if photo.width == 0: Path {
        width: parent.width * 0.6;
        height: parent.height * 0.6;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: ["M 18 80 L 50 22 L 82 80 Z", "M 50 12 L 61 40 L 90 42 L 67 60 L 75 88 L 50 72 L 25 88 L 33 60 L 10 42 L 39 40 Z", "M 62 14 A 38 38 0 1 0 88 62 A 30 30 0 1 1 62 14 Z", "M 50 10 L 84 30 L 84 70 L 50 90 L 16 70 L 16 30 Z", "M 50 14 C 54 32 74 42 74 64 C 74 80 63 90 50 90 C 37 90 26 80 26 64 C 26 54 31 46 37 38 C 39 48 44 52 49 52 C 46 38 46 26 50 14 Z", "M 50 86 C 20 62 12 44 12 32 C 12 20 22 14 32 14 C 40 14 47 19 50 26 C 53 19 60 14 68 14 C 78 14 88 20 88 32 C 88 44 80 62 50 86 Z", "M 56 8 L 24 54 L 46 54 L 40 92 L 76 40 L 54 40 Z", "M 50 10 L 90 50 L 50 90 L 10 50 Z"][min(7, floor(kind / 12))];
        fill: #ffffffe8;
    }
    if photo.width > 0: Image {
        width: parent.width;
        height: parent.height;
        source: photo;
        image-fit: cover;
    }
}


// Logo Hearth : arche de foyer et flamme (vectoriel, aux couleurs du thème). Chemins : tools/make-logo.ps1.
component Logo inherits Rectangle {
    in property <length> size: 64px;
    width: size;
    height: size;
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 14 92 L 14 52 C 14 26 30 8 50 8 C 70 8 86 26 86 52 L 86 92";
        stroke: Theme.accent;
        stroke-width: root.size * 0.07;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 19.9 C 53.5 34.1 68.9 43.5 68.9 62.4 C 68.9 76.6 60.6 86 50 86 C 39.4 86 31.1 76.6 31.1 62.4 C 31.1 53 35.8 45.9 40.6 40 C 41.7 47.1 45.3 50.6 48.8 50.6 C 46.5 38.8 46.5 29.4 50 19.9 Z";
        fill: @linear-gradient(180deg, Theme.accent.brighter(0.35) 0%, Theme.accent 100%);
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 55.3 C 52.4 62.4 59.4 65.9 59.4 73 C 59.4 78.9 54.7 82.5 50 82.5 C 45.3 82.5 40.6 78.9 40.6 73 C 40.6 68.3 44.1 64.8 46.5 61.2 C 47.6 63.6 48.8 62.4 50 55.3 Z";
        fill: Theme.accent.brighter(0.9);
    }
}
// Deux calques d'image en fondu croisé : un changement de source n'apparaît jamais d'un coup.
component HeroFade inherits Rectangle {
    cache-rendering-hint: true;
    in property <image> source;
    property <image> a;
    property <image> b;
    property <bool> show-a: true;
    init => { a = source; }
    changed source => {
        if (show-a) { b = source; show-a = false; }
        else { a = source; show-a = true; }
    }
    Image {
        width: parent.width;
        height: parent.height;
        source: a;
        image-fit: cover;
        opacity: show-a ? 1 : 0;
        animate opacity { duration: 500ms; easing: ease-in-out; }
    }
    Image {
        width: parent.width;
        height: parent.height;
        source: b;
        image-fit: cover;
        opacity: show-a ? 0 : 1;
        animate opacity { duration: 500ms; easing: ease-in-out; }
    }
}

// Tuile portrait (jaquette). Largeur/hauteur fixées par l'appelant.
component GameTile inherits Rectangle {
    cache-rendering-hint: true;
    in property <Tile> tile;
    in property <bool> selected;
    in property <bool> compact: false;
    callback clicked;
    callback options;
    callback hovered;
    callback wheel(int);
    border-radius: 16px;
    clip: true;
    background: @linear-gradient(135deg, tile.hue 0%, tile.hue.darker(0.75) 100%);
    Image {
        width: 100%;
        height: 100%;
        source: tile.cover;
        image-fit: tile.cover.width > tile.cover.height * 0.85 ? contain : cover;
    }
    if tile.cover.width == 0: Text {
        x: parent.width - self.width - 10px;
        y: parent.height - self.height + 14px;
        text: tile.initial;
        color: #ffffff30;
        font-size: parent.height * 0.6;
        font-weight: 800;
    }
    if tile.cover.width == 0: Text {
        x: 16px;
        y: 16px;
        width: parent.width - 32px;
        text: tile.name;
        color: Theme.text;
        font-size: compact ? 22px : 26px;
        font-weight: 700;
        wrap: word-wrap;
    }
    // Boutique d'origine du jeu (Bibliothèque).
    if compact && tile.store != "": Rectangle {
        x: 10px;
        y: 10px;
        width: stl.preferred-width + 20px;
        height: 28px;
        border-radius: 14px;
        background: #000000b8;
        stl := Text {
            text: tile.store;
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
        }
    }
    // Pastilles discrètes (coin bas) : elles ne masquent plus le titre de la jaquette.
    if tile.running: Rectangle {
        x: 10px;
        y: parent.height - 40px;
        width: badge.preferred-width + 20px;
        height: 30px;
        border-radius: 15px;
        background: Theme.accent;
        badge := Text {
            text: @tr("En cours");
            font-size: 16px;
            font-weight: 700;
            color: Theme.on-accent;
        }
    }
    if tile.install: Rectangle {
        x: parent.width - 46px;
        y: parent.height - 46px;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: #000000b0;
        Text {
            text: "\u{E896}";
            font-family: Theme.icons;
            font-size: 18px;
            color: Theme.ok;
        }
    }
    Rectangle {
        border-radius: 16px;
        border-width: selected ? 7px : 0px;
        border-color: Theme.accent;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) { root.options(); }
            if (e.kind == PointerEventKind.move) { root.hovered(); }
        }
        scroll-event(e) => {
            if (e.delta-y != 0) { root.wheel(e.delta-y > 0 ? -1 : 1); return accept; }
            if (e.delta-x != 0) { root.wheel(e.delta-x > 0 ? -1 : 1); return accept; }
            reject
        }
    }
}

// Bouton rond de la barre du haut.
component TopIcon inherits Rectangle {
    in property <string> glyph;
    in property <bool> selected;
    in property <int> badge: 0;
    callback clicked;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: selected ? Theme.accent : transparent;
    animate background { duration: 100ms; }
    TouchArea {
        clicked => { root.clicked(); }
    }
    if glyph != "bell": Text {
        text: glyph;
        font-family: Theme.icons;
        font-size: 30px;
        color: Theme.text;
    }
    // Cloche dessinée (les glyphes de police varient d'une version de Windows à l'autre).
    if glyph == "bell": Path {
        width: 72px;
        height: 72px;
        viewbox-width: 72;
        viewbox-height: 72;
        commands: "M 36 19 C 27 19 24 26 24 34 L 24 42 L 19 48 L 53 48 L 48 42 L 48 34 C 48 26 45 19 36 19 Z M 31 52 C 32 57 40 57 41 52 Z";
        fill: Theme.text;
    }
    if badge > 0: Rectangle {
        x: parent.width - 26px;
        y: 2px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: Theme.danger;
        Text {
            text: badge > 9 ? "9+" : badge;
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
        }
    }
}

// Clavier (debug) -> mêmes actions que la manette.
component NavKeys inherits FocusScope {
    callback nav(int);
    // Saisie au clavier physique (zone clavier virtuel) : un caractère, ou "\b" effacer, "\n" valider.
    callback typed(string);
    in property <bool> typing: false;
    key-pressed(e) => {
        if (e.text == Key.UpArrow) { root.nav(0); return accept; }
        if (e.text == Key.DownArrow) { root.nav(1); return accept; }
        if (e.text == Key.LeftArrow) { root.nav(2); return accept; }
        if (e.text == Key.RightArrow) { root.nav(3); return accept; }
        if (e.text == Key.Escape) { root.nav(5); return accept; }
        if (e.text == Key.Home) { root.nav(6); return accept; }
        if (e.text == Key.Menu || e.text == Key.Insert) { root.nav(7); return accept; }
        if (typing) {
            if (e.text == Key.Return) { root.typed("\n"); return accept; }
            if (e.text == Key.Backspace) { root.typed("\u{8}"); return accept; }
            if (e.modifiers.control && (e.text == "v" || e.text == "V" || e.text == "\u{16}")) { root.typed("\u{16}"); return accept; }
            if (!e.modifiers.control && !e.modifiers.alt) { root.typed(e.text); return accept; }
            return reject;
        }
        if (e.text == Key.Return || e.text == " ") { root.nav(4); return accept; }
        if (e.text == Key.Backspace) { root.nav(5); return accept; }
        reject
    }
}

export component App inherits Window {
    in property <string> ui-font;
    default-font-family: ui-font;
    in property <[Tile]> games; // onglet Jeux : jeux installés
    in property <[Tile]> library; // onglet Bibliothèque : jeux possédés à installer
    in property <string> search-query;
    in property <[Offer]> offers;
    in property <[Notif]> notifs;
    in property <[PickItem]> pick-items;
    in property <string> pick-title;
    in property <string> pick-hint;
    in-out property <int> psel: 0;
    in property <int> unread;
    in property <string> toast-title;
    in property <string> toast-text;
    in property <bool> toast-on;
    in-out property <int> nsel: 0;
    in property <string> offers-state; // "", "loading", "empty"
    in property <string> offers-title;
    in property <[string]> onboard; // boutiques sans compte connecté
    in-out property <int> obsel: 0;
    callback onboard-pick(int);
    in property <image> qr;
    in property <string> qr-title;
    in property <string> qr-url;
    in property <string> qr-hint;
    in property <string> qr-action;
    in property <int> qr-return: 0;
    in-out property <int> osel: 0;
    in-out property <int> brow: 0; // 0 recherche, 1 offres
    // Menu contextuel (options d'un jeu, ajout).
    in property <string> menu-title;
    in property <[string]> menu-items;
    in-out property <int> msel: 0;
    in-out property <int> menu-return: 0;
    // Fiche d'un jeu de la boutique.
    in property <string> det-title;
    in property <string> det-desc;
    in property <string> det-meta;
    in property <image> det-hero;
    in property <image> det-cover;
    in property <[image]> det-shots;
    in property <[Deal]> deals;
    in property <[DlRow]> dl-rows;
    in property <int> dl-badge;
    in property <[ProfileRow]> profiles;
    in property <int> user-avatar: 3;
    in-out property <int> pfsel: 0;
    in-out property <int> avsel: 0; // emblème * 12 + couleur
    in-out property <int> avrow: 0; // 0 emblèmes, 1 couleurs, 2 photo, 3 valider
    in property <image> user-photo;
    in-out property <image> av-photo;
    callback avatar-photo();
    callback profile-open();
    callback profile-pick(int);
    callback profile-menu(int);
    callback avatar-pick(int);
    in-out property <int> dlsel: 0;
    callback dl-pick(int);
    callback dl-open();
    in property <bool> det-loading;
    in-out property <int> dsel: 0;
    in property <string> user: "Joueur";
    in property <string> clock;
    in property <float> phase; // animation du fond (degrés), pilotée par le shell
    in property <[string]> cats;
    in property <int> st-net: -1; // -1 hors ligne, 0 Ethernet, 1 Wi-Fi
    in property <int> st-vol: -1;
    in property <int> st-pad: -1; // -1 aucune, 0..100 batterie, 101 inconnue
    in-out property <bool> dlbtn: false; // focus sur le bouton Annuler du téléchargement sélectionné
    callback dl-cancel(int);
    in property <bool> oobe-on;
    in property <bool> oobe-pad;
    in property <[SettingRow]> oobe-rows;
    in-out property <int> oobe-sel: 0;
    in property <int> oobe-step;
    in property <int> oobe-count;
    in property <string> oobe-title;
    in property <string> oobe-desc;
    in property <string> oobe-hint;
    in property <[string]> oobe-titles;
    callback oobe-key(int);
    callback oobe-click(int);
    in property <[SettingRow]> rows;
    in property <string> shint;
    in property <string> kb-title;
    in property <string> kb-text;
    in property <bool> kb-acc;
    in property <[string]> kb-keys; // 4 rangées de 10 touches
    in property <string> kb-alt;
    in-out property <int> kbx: 0;
    in-out property <int> kby: 0;
    in-out property <int> sel: 0;
    in-out property <int> lsel: 0;
    in-out property <int> ssel: 0;
    in-out property <int> tab: 0; // 0 jeux, 1 bibliothèque, 2 boutique
    in-out property <int> top: 0; // barre du haut : 0-2 onglets, 3 ajouter, 4 notifications, 5 réglages, 6 alimentation
    in-out property <int> zone: 0; // 0 contenu, 1 barre du haut, 2 alimentation, 3 réglages, 4 clavier, 5 QR, 6 sélecteur, 7 fiche, 8 notifications, 9 menu
    in-out property <int> pw: 0;
    in-out property <int> cat: 0;
    in-out property <int> srow: 0;
    in-out property <int> sfocus: 0; // 0 catégories, 1 lignes
    property <int> cols: 10;
    property <int> lrow: floor(lsel / cols);
    property <int> orow: floor(osel / cols);
    callback launch(int); // identifiant interne du jeu
    callback nav-key(int); // touche du clavier physique (le shell joue les sons puis appelle nav)
    callback game-menu(int);
    callback add-menu();
    callback power(int); // 0 veille, 1 redémarrer, 2 éteindre
    callback desktop();
    callback search-open();
    callback pick(int);
    callback qr-act();
    callback qr-cancel();
    callback pick-back();
    callback show-offer(int);
    callback deal-pick(int);
    callback menu-pick(int);
    callback notifs-opened();
    callback notif-action(int); // -1 : tout effacer
    callback kb-press(int, int); // colonne, rangée (rangée 4 = actions) ; (-1, -1) = annuler
    callback kb-char(string);
    callback open-cat(int);
    callback setting(int, int, int); // catégorie, ligne, delta (0 valider, -1/+1 ajuster)

    title: "Hearth";
    no-frame: true;
    background: Theme.bg;
    preferred-width: 1280px;
    preferred-height: 720px;
    forward-focus: keys;

    // a : 0 haut, 1 bas, 2 gauche, 3 droite, 4 valider, 5 retour, 6 guide, 7 menu (cf. input::Nav)
    public function nav(a: int) {
        if (zone == 13) {
            oobe-key(a);
        } else if (a == 6) {
            zone = 0;
        } else if (zone == 12) {
            if (a == 0) { avrow = max(0, avrow - 1); }
            else if (a == 1) { avrow = min(3, avrow + 1); }
            else if (a == 2 || a == 3) {
                av-photo = @image-url("");
                if (avrow == 0) { avsel = mod(floor(avsel / 12) + (a == 3 ? 1 : 7), 8) * 12 + mod(avsel, 12); }
                else if (avrow == 1) { avsel = floor(avsel / 12) * 12 + mod(mod(avsel, 12) + (a == 3 ? 1 : 11), 12); }
            }
            else if (a == 4) { if (avrow == 2) { avatar-photo(); } else if (avrow == 3) { avatar-pick(avsel); } }
            else if (a == 5) { zone = oobe-on ? 13 : 11; }
        } else if (zone == 11) {
            if (a == 0) { pfsel = max(0, pfsel - 1); }
            else if (a == 1) { pfsel = max(0, min(profiles.length - 1, pfsel + 1)); }
            else if (a == 4) { profile-pick(pfsel); }
            else if (a == 7) { profile-menu(pfsel); }
            else if (a == 5) { zone = 1; }
        } else if (zone == 10) {
            if (a == 0) { dlbtn = false; dlsel = max(0, dlsel - 1); }
            else if (a == 1) { dlbtn = false; dlsel = max(0, min(dl-rows.length - 1, dlsel + 1)); }
            else if (a == 3) { if (dl-rows.length > 0 && dl-rows[dlsel].cancel) { dlbtn = true; } }
            else if (a == 2) { dlbtn = false; }
            else if (a == 7) { if (dl-rows.length > 0 && dl-rows[dlsel].cancel) { dl-cancel(dlsel); } }
            else if (a == 4 && dl-rows.length > 0) {
                if (dl-rows[dlsel].cancel) { if (dlbtn) { dl-cancel(dlsel); } else { dlbtn = true; } }
                else { dl-pick(dlsel); }
            }
            else if (a == 5) { if (dlbtn) { dlbtn = false; } else { zone = 1; } }
        } else if (zone == 9) {
            if (a == 0) { msel = max(0, msel - 1); }
            else if (a == 1) { msel = max(0, min(menu-items.length - 1, msel + 1)); }
            else if (a == 4) { menu-pick(msel); }
            else if (a == 5) { zone = menu-return; }
        } else if (zone == 7) {
            if (a == 0) { dsel = max(0, dsel - 1); }
            else if (a == 1) { dsel = max(0, min(deals.length - 1, dsel + 1)); }
            else if (a == 4 && deals.length > 0) { deal-pick(dsel); }
            else if (a == 5) { zone = 0; }
        } else if (zone == 6) {
            if (a == 0) { psel = max(0, psel - 1); }
            else if (a == 1) { psel = max(0, min(pick-items.length - 1, psel + 1)); }
            else if (a == 4) { pick(psel); }
            else if (a == 5) { pick-back(); }
        } else if (zone == 8) {
            if (a == 0) { nsel = max(0, nsel - 1); }
            else if (a == 1) { nsel = max(0, min(notifs.length - 1, nsel + 1)); }
            else if (a == 4 && notifs.length > 0) { notif-action(nsel); nsel = max(0, min(nsel, notifs.length - 2)); }
            else if (a == 7) { notif-action(-1); }
            else if (a == 5) { zone = 1; }
        } else if (zone == 5) {
            if (a == 5) { qr-cancel(); zone = qr-return; }
            else if (a == 4) { if (qr-action != "") { qr-act(); } else { qr-cancel(); zone = qr-return; } }
        } else if (zone == 4) {
            if (a == 0) { kby = max(0, kby - 1); }
            else if (a == 1) { kby = min(4, kby + 1); }
            else if (a == 2) { kbx = max(0, kbx - 1); }
            else if (a == 3) { kbx = min(kby == 4 ? 5 : 9, kbx + 1); }
            else if (a == 4) { kb-press(kbx, kby); }
            else if (a == 5) { kb-press(-1, -1); }
            if (kby == 4 && kbx > 5) { kbx = 5; }
        } else if (zone == 3) {
            if (sfocus == 0) {
                if (a == 0 && cat > 0) { cat = cat - 1; srow = 0; open-cat(cat); }
                else if (a == 1 && cat < cats.length - 1) { cat = cat + 1; srow = 0; open-cat(cat); }
                else if ((a == 3 || a == 4) && rows.length > 0) { sfocus = 1; }
                else if (a == 5) { zone = 1; }
            } else {
                if (a == 0) { srow = max(0, srow - 1); }
                else if (a == 1) { srow = max(0, min(rows.length - 1, srow + 1)); }
                else if (a == 2) { if (rows[srow].adjustable) { setting(cat, srow, -1); } else { sfocus = 0; } }
                else if (a == 3) { if (rows[srow].adjustable) { setting(cat, srow, 1); } }
                else if (a == 4) { setting(cat, srow, 0); }
                else if (a == 5) { sfocus = 0; }
            }
        } else if (zone == 2) {
            if (a == 0) { pw = max(0, pw - 1); }
            else if (a == 1) { pw = min(4, pw + 1); }
            else if (a == 5 || (a == 4 && pw == 4)) { zone = 1; }
            else if (a == 4 && pw == 3) { desktop(); }
            else if (a == 4) { power(pw); }
        } else if (zone == 1) {
            if (a == 2) { top = max(0, top - 1); if (top <= 2) { tab = top; } }
            else if (a == 3) { top = min(8, top + 1); if (top <= 2) { tab = top; } }
            else if (a == 1 || a == 5) { zone = 0; }
            else if (a == 4 && top <= 2) { zone = 0; }
            else if (a == 4 && top == 3) { add-menu(); }
            else if (a == 4 && top == 4) { dlsel = 0; dl-open(); zone = 10; }
            else if (a == 4 && top == 5) { nsel = 0; notifs-opened(); zone = 8; }
            else if (a == 4 && top == 6) { sfocus = 0; srow = 0; zone = 3; open-cat(cat); }
            else if (a == 4 && top == 7) { pw = 0; zone = 2; }
            else if (a == 4 && top == 8) { pfsel = 0; profile-open(); zone = 11; }
        } else {
            if (a == 7) {
                if (tab == 0 && games.length > 0) { game-menu(games[sel].gid); }
                else if (tab == 1 && library.length > 0) { game-menu(library[lsel].gid); }
                else { add-menu(); }
            } else if (tab == 0) {
                if (a == 0 || a == 5) { top = tab; zone = 1; }
                else if (a == 2) { sel = max(0, sel - 1); }
                else if (a == 3) { sel = max(0, min(games.length - 1, sel + 1)); }
                else if (a == 4 && games.length > 0) { launch(games[sel].gid); }
            } else if tab == 1 {
                if (a == 0) { if (lsel < cols) { top = tab; zone = 1; } else { lsel = lsel - cols; } }
                else if (a == 5) { top = tab; zone = 1; }
                else if (a == 1) { lsel = max(0, min(library.length - 1, lsel + cols)); }
                else if (a == 2) { lsel = max(0, lsel - 1); }
                else if (a == 3) { lsel = max(0, min(library.length - 1, lsel + 1)); }
                else if (a == 4 && library.length > 0) { launch(library[lsel].gid); }
            } else {
                if (a == 5 && brow >= 1) { brow = 0; }
                else if (a == 0 && brow == 2) { brow = 0; }
                else if ((a == 0 && brow == 0) || a == 5) { top = tab; zone = 1; }
                else if (brow == 0) {
                    if (a == 4) { search-open(); }
                    else if (a == 3 && onboard.length > 0) { brow = 2; }
                    else if (a == 1 && offers.length > 0) { brow = 1; }
                } else if (brow == 2) {
                    if (a == 2) { if (obsel == 0) { brow = 0; } else { obsel = obsel - 1; } }
                    else if (a == 3) { obsel = max(0, min(onboard.length - 1, obsel + 1)); }
                    else if (a == 1 && offers.length > 0) { brow = 1; }
                    else if (a == 4) { onboard-pick(obsel); }
                } else {
                    if (a == 0) { if (osel < cols) { brow = 0; } else { osel = osel - cols; } }
                    else if (a == 1) { osel = max(0, min(offers.length - 1, osel + cols)); }
                    else if (a == 2) { osel = max(0, osel - 1); }
                    else if (a == 3) { osel = max(0, min(offers.length - 1, osel + 1)); }
                    else if (a == 4) { show-offer(osel); }
                }
            }
        }
    }

    keys := NavKeys {
        typing: zone == 4;
        nav(a) => { root.nav-key(a); }
        typed(t) => { root.kb-char(t); }
    }

    // Clic droit ou bouton « précédent » de la souris sur le fond = Retour.
    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
        }
    }

    // --- Fond : gris très sombre (thème FireLike) ---
    Rectangle {
        background: Theme.bg;
    }

    // --- Onglet Jeux : bandeau de jaquettes, puis fiche du jeu sélectionné ---
    if tab == 0: Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 700px;
        background: Theme.band;
    }
    if tab == 0: Rectangle {
        x: 0px;
        y: 700px;
        width: parent.width;
        height: 28px;
        background: @linear-gradient(180deg, #00000070 0%, #00000000 100%);
    }
    // Visuel du jeu en fond de la fiche, très atténué, avec fondu croisé d'un jeu à l'autre.
    if tab == 0 && games.length > 0: HeroFade {
        x: 0px;
        y: 728px;
        width: 2560px;
        height: 712px;
        opacity: 0.55;
        source: games[sel].hero.width >= 2560 ? games[sel].hero : @image-url("");
    }
    // Voile sombre à gauche : le logo et le bouton Jouer restent lisibles sur n'importe quel visuel.
    if tab == 0 && games.length > 0: Rectangle {
        x: 0px;
        y: 728px;
        width: 1500px;
        height: 712px;
        background: @linear-gradient(90deg, Theme.bg 0%, Theme.bg.transparentize(0.12) 40%, Theme.bg.transparentize(1) 100%);
    }
    if tab == 0 && games.length > 0: Rectangle {
        x: 0px;
        y: 1140px;
        width: 2560px;
        height: 300px;
        background: @linear-gradient(180deg, Theme.bg.transparentize(1) 0%, Theme.bg 100%);
    }
    if tab == 0 && games.length > 0: Rectangle {
        x: 0px;
        y: 728px;
        width: parent.width;
        height: 260px;
        background: @linear-gradient(180deg, Theme.bg 0%, Theme.bg.transparentize(1) 100%);
    }
    // Bandeau : la jaquette sélectionnée est agrandie, les autres défilent autour d'elle.
    if tab == 0: Rectangle {
        x: 0px;
        y: 250px;
        width: parent.width;
        height: 420px;
        for t[i] in games: Rectangle {
            property <int> d: i - sel;
            // Les jeux précédents restent visibles : la liste ne défile que lorsque la sélection dépasse la 3e place.
            property <int> k: i - max(0, sel - 2);
            x: 160px + k * 246px + (d > 0 ? 24px : 0px);
            opacity: k < 0 ? (k == -1 ? 0.35 : 0) : 1;
            y: d == 0 ? 14px : 48px;
            width: d == 0 ? 234px : 210px;
            height: d == 0 ? 370px : 332px;
            animate x, y, width, height, opacity { duration: 190ms; easing: ease-out; }
            if k >= -1 && k <= 9: GameTile {
                width: parent.width;
                height: parent.height;
                tile: t;
                selected: d == 0 && zone == 0;
                clicked => {
                    root.sel = i;
                    root.zone = 0;
                    root.launch(t.gid);
                }
                options => { root.sel = i; root.game-menu(t.gid); }
                hovered => { if (root.zone == 0) { root.sel = i; } }
                wheel(w) => { root.nav(w > 0 ? 3 : 2); }
            }
        }
    }
    // Partie gauche : uniquement le logo du jeu (son nom en repli s'il n'en a pas).
    if tab == 0 && games.length > 0 && games[sel].logo.width > 0: Image {
        x: 160px;
        y: 780px;
        width: min(900px, 340px * games[sel].logo.width / games[sel].logo.height);
        height: 340px;
        source: games[sel].logo;
        image-fit: contain;
    }
    if tab == 0 && games.length > 0 && games[sel].logo.width == 0: Text {
        x: 160px;
        y: 880px;
        width: 1000px;
        text: games[sel].name;
        font-size: 72px;
        font-weight: 800;
        color: Theme.text;
        wrap: word-wrap;
    }
    if tab == 0 && games.length > 0 && (games[sel].played != "" || games[sel].store != ""): Text {
        x: 160px;
        y: 1128px;
        width: 1200px;
        text: (games[sel].store != "" ? games[sel].store + (games[sel].played != "" ? "  ·  " : "") : "") + games[sel].played;
        font-size: 26px;
        color: Theme.dim;
        overflow: elide;
    }
    // Bouton Jouer (orange) et menu d'options.
    if tab == 0 && games.length > 0: Rectangle {
        x: 160px;
        y: 1190px;
        width: 290px;
        height: 82px;
        border-radius: 14px;
        background: Theme.accent;
        Text {
            text: games[sel].running ? @tr("Reprendre") : @tr("Jouer");
            font-size: 34px;
            font-weight: 800;
            color: Theme.on-accent;
        }
        TouchArea {
            clicked => { root.zone = 0; root.launch(root.games[root.sel].gid); }
        }
    }
    if tab == 0 && games.length > 0: Rectangle {
        x: 476px;
        y: 1190px;
        width: 82px;
        height: 82px;
        border-radius: 41px;
        border-width: 3px;
        border-color: #ffffffd0;
        Text {
            text: "···";
            font-size: 34px;
            font-weight: 800;
            color: Theme.text;
        }
        TouchArea {
            clicked => { root.game-menu(root.games[root.sel].gid); }
        }
    }
    if tab == 0 && games.length == 0: Text {
        x: 160px;
        y: 900px;
        width: 1700px;
        text: @tr("Aucun jeu installé. Installez-en un depuis « Non installés » ou la Boutique, ou ajoutez-en un avec le bouton +.");
        font-size: 36px;
        color: Theme.dim;
        wrap: word-wrap;
    }

    // --- Onglets Non installés / Tout : grille de jaquettes ---
    if tab == 1: Rectangle {
        background: Theme.band;
    }
    if tab == 1 && library.length == 0: Text {
        x: 160px;
        y: 400px;
        width: 1800px;
        text: @tr("Aucun jeu à installer. Connectez vos boutiques pour retrouver vos achats.");
        font-size: 36px;
        color: Theme.dim;
        wrap: word-wrap;
    }
    if tab == 1: Rectangle {
        x: 0px;
        y: 170px;
        width: parent.width;
        height: 1190px;
        clip: true;
        // Le défilement anime un seul conteneur (et non des centaines de tuiles).
        Rectangle {
            x: 0px;
            y: -max(0, lrow - 1) * 370px;
            width: parent.width;
            height: 1400px;
            animate y { duration: 160ms; easing: ease-out; }
            for t[i] in library: Rectangle {
                property <int> trow: floor(i / cols);
                property <bool> on: zone == 0 && i == lsel;
                x: 40px + mod(i, cols) * 246px - (on ? 12px : 0px);
                y: 20px + trow * 370px - (on ? 18px : 0px);
                width: on ? 234px : 210px;
                height: on ? 351px : 315px;
                animate x, y, width, height { duration: 130ms; easing: ease-out; }
                // Seules les rangées proches de la sélection existent : pas de centaines de jaquettes en mémoire.
                if trow >= lrow - 2 && trow <= lrow + 3: GameTile {
                    width: parent.width;
                    height: parent.height;
                    compact: true;
                    tile: t;
                    selected: on;
                    clicked => {
                        root.lsel = i;
                        root.zone = 0;
                        root.launch(t.gid);
                    }
                    options => { root.lsel = i; root.game-menu(t.gid); }
                    hovered => { if (root.zone == 0) { root.lsel = i; } }
                    wheel(d) => { root.nav(d > 0 ? 1 : 0); }
                }
            }
        }
    }

    // --- Boutique unifiée : recherche, puis catalogue (toutes boutiques confondues) ---
    if tab == 2: Rectangle {
        x: 80px;
        y: 200px;
        width: 1100px;
        height: 92px;
        border-radius: 46px;
        background: zone == 0 && brow == 0 ? Theme.accent : Theme.glass;
        animate background { duration: 100ms; }
        Text {
            x: 36px;
            text: "\u{E721}";
            font-family: Theme.icons;
            font-size: 34px;
            color: zone == 0 && brow == 0 ? Theme.on-accent : Theme.text;
        }
        Text {
            x: 100px;
            width: parent.width - 130px;
            text: search-query == "" ? @tr("Rechercher un jeu…") : search-query;
            font-size: 32px;
            color: zone == 0 && brow == 0 ? Theme.on-accent : (search-query == "" ? Theme.dim : Theme.text);
            overflow: elide;
        }
        TouchArea {
            clicked => { root.brow = 0; root.search-open(); }
        }
    }
    // Aucun compte connecté : invitation directe à se connecter (une seule fois ; la connexion se gère ensuite dans Réglages).
    for b[i] in onboard: Rectangle {
        x: 1240px + i * 330px;
        y: 200px;
        width: 440px;
        height: 92px;
        border-radius: 46px;
        visible: tab == 2;
        background: zone == 0 && brow == 2 && obsel == i ? Theme.accent : Theme.glass;
        animate background { duration: 100ms; }
        Text {
            text: b;
            font-size: 28px;
            font-weight: 600;
            color: zone == 0 && brow == 2 && obsel == i ? Theme.on-accent : Theme.text;
        }
        TouchArea {
            clicked => { root.brow = 2; root.obsel = i; root.onboard-pick(i); }
        }
    }
    if tab == 2: Text {
        x: 80px;
        y: 330px;
        text: offers-title;
        font-size: 34px;
        font-weight: 600;
        color: Theme.text;
    }
    if tab == 2 && offers-state != "": Text {
        x: 80px;
        y: 460px;
        text: offers-state == "loading" ? @tr("Chargement…") : @tr("Aucune offre (réseau indisponible ?)");
        font-size: 28px;
        color: Theme.dim;
    }
    // Catalogue en grille : jaquette, puis nom, prix et boutique SOUS la jaquette (jamais par-dessus).
    if tab == 2: Rectangle {
        x: 0px;
        y: 390px;
        width: parent.width;
        height: 960px;
        clip: true;
        Rectangle {
            x: 0px;
            y: -max(0, orow - 1) * 450px;
            width: parent.width;
            height: 2400px;
            animate y { duration: 160ms; easing: ease-out; }
            for o[i] in offers: Rectangle {
                property <int> trow: floor(i / cols);
                property <bool> on: brow == 1 && zone == 0 && i == osel;
                x: 40px + mod(i, cols) * 246px;
                y: 20px + trow * 450px;
                width: 210px;
                height: 430px;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: 210px;
                    height: 315px;
                    border-radius: 16px;
                    clip: true;
                    background: @linear-gradient(135deg, #3a3a44 0%, #25252b 100%);
                    // Jaquette absente : grande initiale en filigrane (comme une tuile de jeu sans visuel).
                    if o.art.width == 0: Text {
                        text: o.initial;
                        color: #ffffff30;
                        font-size: 190px;
                        font-weight: 800;
                    }
                    Image {
                        width: 100%;
                        height: 100%;
                        source: o.art;
                        image-fit: o.art.width > o.art.height * 0.85 ? contain : cover;
                    }
                    Rectangle {
                        border-radius: 16px;
                        border-width: on ? 7px : 0px;
                        border-color: Theme.accent;
                    }
                }
                // Titre sur deux lignes (deux éditions d'un même jeu restent distinguables), puis prix et boutique sur une ligne.
                Text {
                    x: 0px;
                    y: 326px;
                    width: 210px;
                    height: 60px;
                    text: o.title;
                    font-size: 22px;
                    font-weight: 600;
                    color: on ? Theme.text : Theme.dim;
                    wrap: word-wrap;
                    overflow: elide;
                }
                Text {
                    x: 0px;
                    y: 384px;
                    width: 210px;
                    text: o.owned ? @tr("Possédé") : o.price;
                    font-size: o.owned ? 22px : 24px;
                    font-weight: 800;
                    color: o.owned ? Theme.ok : Theme.accent;
                    overflow: elide;
                }
                Text {
                    x: 0px;
                    y: 416px;
                    width: 210px;
                    text: o.store;
                    font-size: 18px;
                    color: Theme.dim;
                    overflow: elide;
                }
                TouchArea {
                    clicked => { root.brow = 1; root.osel = i; root.show-offer(i); }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.move && root.zone == 0 && root.brow == 1) { root.osel = i; }
                    }
                    scroll-event(e) => {
                        if (e.delta-y != 0) { root.nav(e.delta-y > 0 ? 0 : 1); return accept; }
                        reject
                    }
                }
            }
        }
    }

    // Barre d'état, à droite de l'heure : réseau, volume, manette (avec batterie si elle est connue).
    HorizontalLayout {
        x: 350px;
        y: 30px;
        height: 56px;
        spacing: 34px;
        Rectangle {
            width: 40px;
            Text {
                text: st-net == 0 ? "\u{E839}" : "\u{E701}";
                font-family: Theme.icons;
                font-size: 34px;
                color: st-net < 0 ? Theme.danger : Theme.text;
            }
        }
        Rectangle {
            width: 44px + vtxt.preferred-width;
            Text {
                x: 0px;
                text: st-vol == 0 ? "\u{E74F}" : "\u{E767}";
                font-family: Theme.icons;
                font-size: 34px;
                color: Theme.text;
            }
            vtxt := Text {
                x: 46px;
                text: st-vol < 0 ? "" : st-vol + "%";
                font-size: 24px;
                color: Theme.dim;
            }
        }
        if st-pad >= 0: Rectangle {
            width: 44px + ptxt.preferred-width;
            Text {
                x: 0px;
                text: "\u{E7FC}";
                font-family: Theme.icons;
                font-size: 34px;
                color: st-pad <= 15 ? Theme.danger : Theme.text;
            }
            ptxt := Text {
                x: 46px;
                text: st-pad <= 100 ? st-pad + "%" : "";
                font-size: 24px;
                color: st-pad <= 15 ? Theme.danger : Theme.dim;
            }
        }
    }
    // --- Barre du haut : heure à gauche, onglets au centre, raccourcis et profil à droite (thème FireLike) ---
    Logo {
        x: 80px;
        y: 22px;
        size: 76px;
    }
    Text {
        x: 176px;
        y: 34px;
        text: clock;
        font-size: 34px;
        color: Theme.text;
    }
    HorizontalLayout {
        x: 0px;
        y: 84px;
        width: parent.width;
        height: 70px;
        alignment: center;
        spacing: 24px;
        for t[i] in [@tr("Jeux"), @tr("Bibliothèque"), @tr("Boutique")]: Rectangle {
            width: tt.preferred-width + 64px;
            height: 66px;
            border-radius: 33px;
            background: tab == i ? Theme.accent : (zone == 1 && top == i ? #ffffff30 : Theme.glass);
            border-width: zone == 1 && top == i ? 3px : 0px;
            border-color: Theme.text;
            animate background { duration: 100ms; }
            tt := Text {
                text: t;
                font-size: 36px;
                font-weight: tab == i ? 800 : 500;
                color: tab == i ? Theme.on-accent : Theme.text;
            }
            TouchArea {
                clicked => { root.tab = i; root.top = i; root.zone = 0; }
            }
        }
    }
    HorizontalLayout {
        x: 0px;
        y: 62px;
        width: parent.width - 70px;
        height: 72px;
        alignment: end;
        spacing: 18px;
        for g[i] in ["\u{E710}", "\u{E896}", "bell", "\u{E713}", "\u{E7E8}"]: TopIcon {
            glyph: g;
            badge: i == 1 ? dl-badge : (i == 2 ? unread : 0);
            selected: zone == 1 && top == i + 3;
            clicked => {
                root.top = i + 3;
                root.zone = 1;
                root.nav(4);
            }
        }
        Rectangle {
            width: 12px;
        }
        Rectangle {
            width: 66px;
            height: 66px;
            border-radius: 33px;
            border-width: zone == 1 && top == 8 ? 4px : 0px;
            border-color: Theme.accent;
            Avatar {
                kind: user-avatar;
                photo: user-photo;
                size: 66px;
            }
            TouchArea {
                clicked => { root.top = 8; root.zone = 1; root.nav(4); }
            }
        }
    }

    // --- Pictogrammes de la manette ---
    HorizontalLayout {
        x: 40px;
        y: parent.height - 76px;
        spacing: 56px;
        Hint { btn: 0; label: @tr("Valider"); }
        Hint { btn: 3; label: @tr("Options"); }
        Hint { btn: 1; label: @tr("Retour"); }
        Hint { btn: 2; label: @tr("Menu"); }
    }

    // --- Fiche d'un jeu de la boutique : description, captures, prix par boutique ---
    if zone == 7: Rectangle {
        background: Theme.bg-settings;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
            }
        }
        if det-hero.width >= 1400: Image {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 760px;
            source: det-hero;
            image-fit: cover;
        }
        // Voile sur tout le visuel : titre, genres et description restent lisibles même sur une image claire.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 760px;
            background: Theme.bg.transparentize(0.4);
        }
        Rectangle {
            x: 0px;
            y: 380px;
            width: parent.width;
            height: 380px;
            background: @linear-gradient(180deg, Theme.bg.transparentize(1) 0%, Theme.bg 100%);
        }
        Rectangle {
            x: 0px;
            y: 0px;
            width: 2100px;
            height: 760px;
            background: @linear-gradient(90deg, Theme.bg.transparentize(0.06) 0%, Theme.bg.transparentize(1) 100%);
        }
        Rectangle {
            x: 100px;
            y: 190px;
            width: 400px;
            height: 600px;
            border-radius: 20px;
            clip: true;
            background: Theme.tile;
            Image {
                width: 100%;
                height: 100%;
                source: det-cover;
                image-fit: cover;
            }
        }
        Text {
            x: 560px;
            y: 170px;
            width: parent.width - 660px;
            text: det-title;
            font-size: 72px;
            font-weight: 800;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: 564px;
            y: 270px;
            width: parent.width - 660px;
            text: det-meta;
            font-size: 26px;
            color: Theme.dim;
            overflow: elide;
        }
        Text {
            x: 564px;
            y: 330px;
            width: 1500px;
            height: 220px;
            text: det-loading && det-desc == "" ? @tr("Chargement…") : det-desc;
            font-size: 28px;
            color: Theme.text;
            wrap: word-wrap;
            overflow: elide;
        }
        for s[i] in det-shots: Rectangle {
            x: 564px + i * 350px;
            y: 580px;
            width: 330px;
            height: 186px;
            border-radius: 12px;
            clip: true;
            background: #ffffff22;
            Image {
                width: 100%;
                height: 100%;
                source: s;
                image-fit: cover;
            }
        }
        Text {
            x: 564px;
            y: 800px;
            text: @tr("Disponible sur");
            font-size: 28px;
            font-weight: 600;
            color: Theme.dim;
        }
        for d[i] in deals: Rectangle {
            x: 564px;
            y: 850px + i * 92px;
            width: 1100px;
            height: 80px;
            border-radius: 14px;
            background: i == dsel ? Theme.accent : #ffffff1a;
            animate background { duration: 100ms; }
            Text {
                x: 28px;
                text: d.store;
                font-size: 30px;
                font-weight: 600;
                color: i == dsel ? Theme.on-accent : Theme.text;
            }
            Text {
                x: parent.width - self.width - 28px;
                text: d.price;
                font-size: 30px;
                font-weight: 700;
                color: i == dsel ? Theme.on-accent : Theme.text;
            }
            TouchArea {
                clicked => { root.dsel = i; root.deal-pick(i); }
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.move) { root.dsel = i; }
                }
            }
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Acheter (QR code)"); }
            Hint { btn: 1; label: @tr("Retour"); }
        }
    }

    // --- Téléchargements et mises à jour ---
    if zone == 10: Rectangle {
        background: Theme.bg-settings;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
            }
        }
        Text {
            x: 80px;
            y: 100px;
            text: @tr("Téléchargements");
            font-size: 64px;
            font-weight: 800;
            color: Theme.text;
        }
        Text {
            x: 84px;
            y: 240px;
            text: @tr("Mises à jour et téléchargements des jeux installés par Hearth");
            font-size: 28px;
            color: Theme.dim;
        }
        Rectangle {
            x: 80px;
            y: 320px;
            width: parent.width - 160px;
            height: min(dl-rows.length, 9) * 112px + 24px;
            clip: true;
            border-radius: 18px;
            background: Theme.glass;
            for r[i] in dl-rows: Rectangle {
                x: 12px;
                y: 12px + (i - max(0, dlsel - 8)) * 112px;
                width: parent.width - 24px;
                height: 104px;
                border-radius: 14px;
                background: i == dlsel ? Theme.accent : transparent;
                animate background { duration: 100ms; }
                Text {
                    x: 32px;
                    y: r.pct >= 0 ? 16px : (parent.height - self.height) / 2;
                    width: parent.width - 940px - (r.cancel ? 200px : 0px);
                    text: r.name;
                    font-size: 30px;
                    font-weight: r.kind == 3 ? 700 : 500;
                    color: i == dlsel ? Theme.on-accent : Theme.text;
                    overflow: elide;
                }
                Text {
                    x: parent.width - self.width - 32px - (r.cancel ? 220px : 0px);
                    y: r.pct >= 0 ? 16px : (parent.height - self.height) / 2;
                    text: r.status;
                    font-size: 26px;
                    color: i == dlsel ? Theme.on-accent : (r.kind == 1 ? #ffd27a : Theme.dim);
                }
                // Bouton dédié : Droite (ou Entrée) pour le sélectionner, puis une confirmation avant d'annuler.
                if r.cancel: Rectangle {
                    x: parent.width - 200px - 24px;
                    y: 24px;
                    width: 200px;
                    height: 56px;
                    border-radius: 28px;
                    background: i == dlsel && dlbtn ? Theme.danger : (i == dlsel ? Theme.on-accent.transparentize(0.8) : Theme.glass);
                    border-width: 2px;
                    border-color: i == dlsel && dlbtn ? Theme.danger : Theme.dim.transparentize(0.5);
                    Text {
                        text: @tr("Annuler");
                        font-size: 24px;
                        font-weight: 700;
                        color: i == dlsel && dlbtn ? #ffffff : (i == dlsel ? Theme.on-accent : Theme.text);
                    }
                    TouchArea { clicked => { root.dlsel = i; root.dl-cancel(i); } }
                }
                if r.pct >= 0: Rectangle {
                    x: 32px;
                    y: 66px;
                    width: parent.width - 64px;
                    height: 14px;
                    border-radius: 7px;
                    background: #ffffff33;
                    Rectangle {
                        x: 0px;
                        y: 0px;
                        height: parent.height;
                        width: max(14px, parent.width * min(r.pct, 100) / 100);
                        border-radius: 7px;
                        background: Theme.text;
                    }
                }
                TouchArea {
                    clicked => { root.dlsel = i; if (!r.cancel) { root.dl-pick(i); } }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.move) { root.dlsel = i; }
                    }
                    scroll-event(e) => {
                        if (e.delta-y != 0) { root.nav(e.delta-y > 0 ? 0 : 1); return accept; }
                        reject
                    }
                }
            }
        }
        if dl-rows.length <= 1: Text {
            x: 84px;
            y: 320px + 150px;
            text: @tr("Aucun téléchargement en cours. Les installations depuis la Bibliothèque et les mises à jour apparaîtront ici.");
            font-size: 28px;
            color: Theme.dim;
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Valider"); }
            Hint { btn: 1; label: @tr("Retour"); }
            if dl-rows.length > 0 && dl-rows[dlsel].cancel: Hint { btn: 3; label: @tr("Annuler le téléchargement"); }
        }
    }

    // --- Profils ---
    if zone == 11: Rectangle {
        background: Theme.bg-settings;
        TouchArea {
            pointer-event(e) => {
                if (e.kind == PointerEventKind.up && (e.button == PointerEventButton.right || e.button == PointerEventButton.back)) { root.nav(5); }
            }
        }
        Text {
            x: 80px;
            y: 100px;
            text: @tr("Profils");
            font-size: 64px;
            font-weight: 800;
            color: Theme.text;
