        Text {
            x: 84px;
            y: 240px;
            text: @tr("Chaque profil a ses comptes de boutiques, sa liste de jeux et son temps de jeu");
            font-size: 28px;
            color: Theme.dim;
        }
        for p[i] in profiles: Rectangle {
            x: 80px;
            y: 330px + i * 124px;
            width: 1300px;
            height: 108px;
            border-radius: 18px;
            background: i == pfsel ? Theme.accent : Theme.glass;
            animate background { duration: 100ms; }
            if !p.add: Avatar {
                x: 24px;
                kind: p.avatar;
                photo: p.photo;
                size: 76px;
            }
            if p.add: Rectangle {
                x: 24px;
                width: 76px;
                height: 76px;
                border-radius: 38px;
                background: #ffffff22;
                Text {
                    text: "\u{E710}";
