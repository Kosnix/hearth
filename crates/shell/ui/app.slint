        }
        Text {
            x: 760px;
            y: 290px;
            text: @tr("Forme");
            font-size: 28px;
            color: Theme.dim;
        }
        for e[i] in 8: Rectangle {
            x: 760px + i * 150px;
            y: 340px;
            width: 130px;
            height: 130px;
            border-radius: 65px;
            border-width: floor(avsel / 12) == i ? (avrow == 0 ? 8px : 4px) : 0px;
            border-color: avrow == 0 ? Theme.accent : Theme.text;
            Avatar {
                kind: i * 12 + mod(avsel, 12);
                size: 130px;
            }
            TouchArea { clicked => { root.avrow = 0; root.av-photo = @image-url(""); root.avsel = i * 12 + mod(root.avsel, 12); } }
        }
        Text {
            x: 760px;
            y: 530px;
            text: @tr("Couleur");
            font-size: 28px;
            color: Theme.dim;
        }
        for c[i] in 12: Rectangle {
            x: 760px + mod(i, 6) * 200px;
            y: 580px + floor(i / 6) * 120px;
            width: 100px;
            height: 100px;
            border-radius: 50px;
            border-width: mod(avsel, 12) == i ? (avrow == 1 ? 8px : 4px) : 0px;
            border-color: avrow == 1 ? Theme.accent : Theme.text;
            Avatar {
                kind: floor(avsel / 12) * 12 + i;
                size: 100px;
            }
            TouchArea { clicked => { root.avrow = 1; root.av-photo = @image-url(""); root.avsel = floor(root.avsel / 12) * 12 + i; } }
        }
        Rectangle {
            x: 760px;
            y: 860px;
            width: 540px;
            height: 92px;
            border-radius: 46px;
            background: avrow == 2 ? Theme.accent : Theme.glass;
