// Direction visuelle : docs/design.md (thème bleu conservé) ; squelette d'accueil façon PS5.
// Les textes sont en français (langue source) et traduits par @tr (dossier lang/).

export struct Tile {
    name: string,
    initial: string,
    hue: color,
    cover: image,
    hero: image,
    running: bool,
    add: bool,
    install: bool,
}

export struct SettingRow {
    label: string,
    value: string,
    adjustable: bool,
}

export struct Notif {
    title: string,
    text: string,
    time: string,
    unread: bool,
}

export struct PickItem {
    label: string,
    sub: string,
    glyph: string,
    art: image,
}

export struct Offer {
    title: string,
    price: string,
    store: string,
    art: image,
}

export global Theme {
    out property <brush> bg: @linear-gradient(180deg, #3d5a99 0%, #2a2166 100%);
    out property <brush> bg-settings: @linear-gradient(180deg, #34508f 0%, #231b5a 100%);
    out property <brush> bg-guide: @linear-gradient(180deg, #2c3b84 0%, #1c1650 100%);
    out property <color> panel: #1b2142ee;
    out property <color> glass: #ffffff1f;
    out property <color> tile: #2b3566;
    out property <color> accent: #3d7bff;
    out property <color> text: #ffffff;
    out property <color> dim: #c3cae6;
    out property <string> icons: "Segoe MDL2 Assets";
}

// Dernière manette utilisée : 0 Xbox/générique, 1 PlayStation (renseigné par le shell).
export global Pad {
    in-out property <int> kind: 0;
}

// Pictogramme d'un bouton de manette. btn : 0 valider, 1 retour, 2 guide, 3 menu.
component PadGlyph inherits Rectangle {
    in property <int> btn;
    property <bool> ps: Pad.kind == 1;
    property <color> tint: ps ? (btn == 0 ? #6fa8ff : btn == 1 ? #ff6b7a : #ffffff) : (btn == 0 ? #5fd068 : btn == 1 ? #ff5a4f : #ffffff);
    width: 48px;
    height: 48px;
    // Disque : sombre à anneau coloré (PlayStation) ou plein coloré avec reflet (Xbox A/B).
    Rectangle {
        border-radius: 24px;
        background: ps ? @linear-gradient(180deg, #2a2f55 0%, #12152e 100%) : (btn <= 1 ? @linear-gradient(180deg, tint.brighter(0.35) 0%, tint.darker(0.25) 100%) : @linear-gradient(180deg, #3a3f6a 0%, #1a1d3a 100%));
        border-width: ps ? 3px : (btn <= 1 ? 0px : 2px);
        border-color: tint;
    }
    // PlayStation : croix et rond épais, logo PS.
    if ps && btn == 0: Path {
        width: 48px;
        height: 48px;
        viewbox-width: 48;
        viewbox-height: 48;
        commands: "M 16 16 L 32 32 M 32 16 L 16 32";
        stroke: tint;
        stroke-width: 5px;
        stroke-line-cap: round;
    }
    if ps && btn == 1: Rectangle {
        x: 14px;
        y: 14px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 5px;
        border-color: tint;
    }
    if ps && btn == 2: Text {
        text: "PS";
        font-size: 18px;
        font-weight: 900;
        color: tint;
    }
    // Xbox : lettres sombres sur disque coloré, manette pour le bouton guide.
    if !ps && btn <= 1: Text {
        text: btn == 0 ? "A" : "B";
        font-size: 28px;
        font-weight: 900;
        color: #101232;
    }
    if !ps && btn == 2: Text {
        text: "\u{E7FC}";
        font-family: Theme.icons;
        font-size: 24px;
        color: tint;
    }
    // Menu / Options : trois traits.
    if btn == 3: Path {
        width: 48px;
        height: 48px;
        viewbox-width: 48;
        viewbox-height: 48;
        commands: "M 14 17 L 34 17 M 14 24 L 34 24 M 14 31 L 34 31";
        stroke: #ffffff;
        stroke-width: 3px;
        stroke-line-cap: round;
    }
}

component Hint inherits Rectangle {
    in property <int> btn;
    in property <string> label;
    width: 64px + lbl.preferred-width;
    height: 48px;
    PadGlyph {
        x: 0px;
        btn: root.btn;
    }
    lbl := Text {
        x: 64px;
        text: label;
        font-size: 24px;
        y: (parent.height - self.height) / 2;
        color: Theme.dim;
    }
}

component GameTile inherits Rectangle {
    in property <Tile> tile;
    in property <bool> selected;
    callback clicked;
    width: selected ? 300px : 240px;
    height: selected ? 300px : 240px;
    animate width, height { duration: 120ms; easing: ease-out; }
    Rectangle {
        border-radius: 18px;
        clip: true;
        background: tile.add ? #ffffff26 : @linear-gradient(135deg, tile.hue 0%, tile.hue.darker(0.75) 100%);
        Image {
            width: 100%;
            height: 100%;
            source: tile.cover;
            image-fit: cover;
        }
        if tile.add: Text {
            y: parent.height / 2 - 50px;
            text: "\u{E710}";
            font-family: Theme.icons;
            font-size: 72px;
            color: Theme.text;
        }
        if tile.add: Text {
            y: parent.height / 2 + 50px;
            text: @tr("Ajouter un jeu");
            font-size: 24px;
            font-weight: 600;
            color: Theme.text;
        }
        if tile.cover.width == 0 && !tile.add: Text {
            x: parent.width - self.width - 14px;
            y: parent.height - self.height + 18px;
            text: tile.initial;
            color: #ffffff30;
            font-size: 190px;
            font-weight: 800;
        }
        if tile.cover.width == 0 && !tile.add: Text {
            x: 20px;
            y: 20px;
            width: parent.width - 40px;
            text: tile.name;
            color: Theme.text;
            font-size: 26px;
            font-weight: 700;
            wrap: word-wrap;
        }
        if tile.running: Rectangle {
            x: 12px;
            y: 12px;
            width: badge.preferred-width + 20px;
            height: 32px;
            border-radius: 16px;
            background: Theme.accent;
            badge := Text {
                text: @tr("En cours");
                font-size: 16px;
                color: Theme.text;
            }
        }
        if tile.install: Rectangle {
            x: 12px;
            y: 12px;
            width: badge2.preferred-width + 20px;
            height: 32px;
            border-radius: 16px;
            background: #2fa36b;
            badge2 := Text {
                text: @tr("À installer");
                font-size: 16px;
                color: Theme.text;
            }
        }
        Rectangle {
            border-radius: 18px;
            border-width: selected ? 5px : 0px;
            border-color: Theme.text;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Bouton rond de la barre du haut.
component TopIcon inherits Rectangle {
    in property <string> glyph;
    in property <bool> selected;
    in property <int> badge: 0;
    width: 72px;
    height: 72px;
    border-radius: 36px;
    background: selected ? Theme.accent : Theme.glass;
    animate background { duration: 100ms; }
    if glyph != "bell": Text {
        text: glyph;
        font-family: Theme.icons;
        font-size: 30px;
        color: Theme.text;
    }
    // Cloche dessinée (les glyphes de police varient d'une version de Windows à l'autre).
    if glyph == "bell": Path {
        width: 72px;
        height: 72px;
        viewbox-width: 72;
        viewbox-height: 72;
        commands: "M 36 19 C 27 19 24 26 24 34 L 24 42 L 19 48 L 53 48 L 48 42 L 48 34 C 48 26 45 19 36 19 Z M 31 52 C 32 57 40 57 41 52 Z";
        fill: Theme.text;
    }
    if badge > 0: Rectangle {
        x: parent.width - 26px;
        y: 2px;
        width: 30px;
        height: 30px;
        border-radius: 15px;
        background: #ff5b5b;
        Text {
            text: badge > 9 ? "9+" : badge;
            font-size: 16px;
            font-weight: 700;
            color: #ffffff;
        }
    }
}

// Clavier (debug) -> mêmes actions que la manette.
component NavKeys inherits FocusScope {
    callback nav(int);
    key-pressed(e) => {
        if (e.text == Key.UpArrow) { root.nav(0); return accept; }
        if (e.text == Key.DownArrow) { root.nav(1); return accept; }
        if (e.text == Key.LeftArrow) { root.nav(2); return accept; }
        if (e.text == Key.RightArrow) { root.nav(3); return accept; }
        if (e.text == Key.Return) { root.nav(4); return accept; }
        if (e.text == Key.Escape) { root.nav(5); return accept; }
        if (e.text == Key.Home) { root.nav(6); return accept; }
        reject
    }
}

export component App inherits Window {
    in property <[Tile]> games;
    in property <string> search-query;
    in property <[Offer]> offers;
    in property <[Notif]> notifs;
    in property <[PickItem]> pick-items;
    in property <string> pick-title;
    in property <string> pick-hint;
    in-out property <int> psel: 0;
    in property <int> unread;
    in property <string> toast-title;
    in property <string> toast-text;
    in property <bool> toast-on;
    in-out property <int> nsel: 0;
    in property <string> offers-state; // "", "loading", "empty"
    in property <string> offers-title;
    in property <image> qr;
    in property <string> qr-title;
    in property <string> qr-url;
    in property <string> qr-hint;
    in property <string> qr-action;
    in property <int> qr-return: 0;
    in-out property <int> osel: 0;
    in-out property <int> brow: 0; // 0 boutiques, 1 offres
    in property <string> user: "Joueur";
    in property <string> clock;
    in property <float> phase; // animation du fond (degrés), pilotée par le shell
    in property <[string]> cats;
    in property <[SettingRow]> rows;
    in property <string> shint;
    in property <string> kb-title;
    in property <string> kb-text;
    in property <[string]> kb-keys; // 4 rangées de 10 touches
    in-out property <int> kbx: 0;
    in-out property <int> kby: 0;
    in-out property <int> sel: 0;
    in-out property <int> ssel: 0;
    in-out property <int> tab: 0; // 0 jeux, 1 boutique
    in-out property <int> top: 0; // barre du haut : 0-1 onglets, 2 réglages, 3 bureau, 4 alimentation
    in-out property <int> zone: 0; // 0 contenu, 1 barre du haut, 2 menu alimentation, 3 réglages, 4 clavier, 5 QR d'achat
    in-out property <int> pw: 0;
    in-out property <int> cat: 0;
    in-out property <int> srow: 0;
    in-out property <int> sfocus: 0; // 0 catégories, 1 lignes
    callback launch(int);
    callback power(int); // 0 veille, 1 redémarrer, 2 éteindre
    callback desktop();
    callback search-open();
    callback pick(int);
    callback qr-act();
    callback qr-cancel();
    callback pick-back();
    callback show-offer(int);
    callback notifs-opened();
    callback notif-action(int); // -1 : tout effacer
    callback kb-press(int, int); // colonne, rangée (rangée 4 = actions) ; (-1, -1) = annuler
    callback open-cat(int);
    callback setting(int, int, int); // catégorie, ligne, delta (0 valider, -1/+1 ajuster)

    title: "Hearth";
    no-frame: true;
    background: #2a2166;
    preferred-width: 1280px;
    preferred-height: 720px;
    forward-focus: keys;

    // a : 0 haut, 1 bas, 2 gauche, 3 droite, 4 valider, 5 retour, 6 guide, 7 menu (cf. input::Nav)
    public function nav(a: int) {
        if (a == 6) {
            zone = 0;
        } else if (zone == 6) {
            if (a == 0) { psel = max(0, psel - 1); }
            else if (a == 1) { psel = min(pick-items.length - 1, psel + 1); }
            else if (a == 4) { pick(psel); }
            else if (a == 5) { pick-back(); }
        } else if (zone == 8) {
            if (a == 0) { nsel = max(0, nsel - 1); }
            else if (a == 1) { nsel = min(notifs.length - 1, nsel + 1); }
            else if (a == 4 && notifs.length > 0) { notif-action(nsel); nsel = max(0, min(nsel, notifs.length - 2)); }
            else if (a == 7) { notif-action(-1); }
            else if (a == 5) { zone = 1; }
        } else if (zone == 5) {
            if (a == 5) { qr-cancel(); zone = qr-return; }
            else if (a == 4) { if (qr-action != "") { qr-act(); } else { zone = qr-return; } }
        } else if (zone == 4) {
            if (a == 0) { kby = max(0, kby - 1); }
            else if (a == 1) { kby = min(4, kby + 1); }
            else if (a == 2) { kbx = max(0, kbx - 1); }
            else if (a == 3) { kbx = min(kby == 4 ? 4 : 9, kbx + 1); }
            else if (a == 4) { kb-press(kbx, kby); }
            else if (a == 5) { kb-press(-1, -1); }
            if (kby == 4 && kbx > 4) { kbx = 4; }
        } else if (zone == 3) {
            if (sfocus == 0) {
                if (a == 0 && cat > 0) { cat = cat - 1; srow = 0; open-cat(cat); }
                else if (a == 1 && cat < cats.length - 1) { cat = cat + 1; srow = 0; open-cat(cat); }
                else if ((a == 3 || a == 4) && rows.length > 0) { sfocus = 1; }
                else if (a == 5) { zone = 1; }
            } else {
                if (a == 0) { srow = max(0, srow - 1); }
                else if (a == 1) { srow = min(rows.length - 1, srow + 1); }
                else if (a == 2) { if (rows[srow].adjustable) { setting(cat, srow, -1); } else { sfocus = 0; } }
                else if (a == 3) { if (rows[srow].adjustable) { setting(cat, srow, 1); } }
                else if (a == 4) { setting(cat, srow, 0); }
                else if (a == 5) { sfocus = 0; }
            }
        } else if (zone == 2) {
            if (a == 0) { pw = max(0, pw - 1); }
            else if (a == 1) { pw = min(4, pw + 1); }
            else if (a == 5 || (a == 4 && pw == 4)) { zone = 1; }
            else if (a == 4 && pw == 3) { desktop(); }
            else if (a == 4) { power(pw); }
        } else if (zone == 1) {
            if (a == 2) { top = max(0, top - 1); if (top <= 1) { tab = top; } }
            else if (a == 3) { top = min(4, top + 1); if (top <= 1) { tab = top; } }
            else if (a == 1 || a == 5) { zone = 0; }
            else if (a == 4 && top <= 1) { zone = 0; }
            else if (a == 4 && top == 2) { nsel = 0; notifs-opened(); zone = 8; }
            else if (a == 4 && top == 3) { sfocus = 0; srow = 0; zone = 3; open-cat(cat); }
            else if (a == 4 && top == 4) { pw = 0; zone = 2; }
        } else {
            if (a == 5 && brow == 1 && tab == 1) { brow = 0; }
            else if (a == 0 && brow == 1 && tab == 1) { brow = 0; }
            else if (a == 0 || a == 5) { top = tab; zone = 1; }
            else if (tab == 0) {
                if (a == 2) { sel = max(0, sel - 1); }
                else if (a == 3) { sel = min(games.length - 1, sel + 1); }
                else if (a == 4 && games.length > 0) { launch(sel); }
            } else {
                if (brow == 0) {
                    if (a == 4) { search-open(); }
                    else if (a == 1 && offers.length > 0) { brow = 1; }
                } else {
                    if (a == 2) { osel = max(0, osel - 1); }
                    else if (a == 3) { osel = min(offers.length - 1, osel + 1); }
                    else if (a == 0) { brow = 0; }
                    else if (a == 4) { show-offer(osel); }
                }
            }
        }
    }

    keys := NavKeys {
        nav(a) => { root.nav(a); }
    }

    // --- Fond animé : dégradé + halos lents (le shell avance `phase` ~15 fois/s, arrêté en jeu) ---
    Rectangle {
        background: Theme.bg;
    }
    Rectangle {
        x: -100px + 220px * sin(phase * 1deg);
        y: -100px + 120px * cos(phase * 1.3deg);
        width: 1300px;
        height: 950px;
        background: @radial-gradient(circle, #7d9cff48 0%, #7d9cff00 70%);
    }
    Rectangle {
        x: parent.width - 1300px - 200px * cos(phase * 0.8deg);
        y: parent.height - 900px + 110px * sin(phase * 1.1deg);
        width: 1300px;
        height: 950px;
        background: @radial-gradient(circle, #9a6bff40 0%, #9a6bff00 70%);
    }

    // --- Accueil (onglet Jeux) ---
    if tab == 0 && games.length > 0 && games[sel].hero.width > 0: Image {
        x: parent.width * 0.40;
        y: 0px;
        width: parent.width * 0.60;
        height: parent.height * 0.62;
        source: games[sel].hero;
        image-fit: cover;
        opacity: 0.6;
    }
    if tab == 0 && games.length > 0 && games[sel].hero.width > 0: Rectangle {
        x: parent.width * 0.38;
        width: parent.width * 0.62;
        height: parent.height * 0.62;
        background: @linear-gradient(90deg, #35468f 0%, #35468f00 70%);
    }
    // Pas de visuel : grand halo teinté et initiale géante à droite.
    if tab == 0 && games.length > 0 && games[sel].hero.width == 0: Rectangle {
        x: parent.width * 0.50;
        y: 60px;
        width: 1000px;
        height: 1000px;
        border-radius: 500px;
        background: @radial-gradient(circle, games[sel].hue.with-alpha(0.65) 0%, games[sel].hue.with-alpha(0) 70%);
        Text {
            text: games[sel].initial;
            font-size: 560px;
            font-weight: 800;
            color: #ffffff1c;
        }
    }
    if tab == 0: Text {
        x: 80px;
        y: 260px;
        width: parent.width * 0.62;
        text: games.length > 0 ? games[sel].name : @tr("Aucun jeu");
        font-size: games.length > 0 && games[sel].name.character-count > 16 ? 64px : 88px;
        font-weight: 800;
        color: Theme.text;
        overflow: elide;
    }
    if tab == 0 && games.length > 0: Rectangle {
        x: 80px;
        y: 400px;
        width: playlbl.preferred-width + 44px + 60px;
        height: 76px;
        border-radius: 38px;
        background: zone == 0 ? Theme.accent : Theme.glass;
        animate background { duration: 120ms; }
        PadGlyph {
            x: 16px;
            btn: 0;
        }
        playlbl := Text {
            x: 76px;
            text: games[sel].add ? @tr("Ajouter") : (games[sel].install ? @tr("Installer") : (games[sel].running ? @tr("Reprendre") : @tr("Jouer")));
            font-size: 30px;
            font-weight: 600;
            color: Theme.text;
        }
        TouchArea {
            clicked => { root.zone = 0; root.launch(root.sel); }
        }
    }
    if tab == 0: Rectangle {
        x: 80px - max(0, sel - 5) * 268px;
        y: 560px;
        width: games.length * 300px;
        height: 340px;
        animate x { duration: 150ms; easing: ease-out; }
        for t[i] in games: GameTile {
            x: i * 268px + (i > sel ? 60px : 0px);
            y: i == sel ? (zone == 0 ? -30px : -10px) : 30px;
            animate x, y { duration: 120ms; easing: ease-out; }
            tile: t;
            selected: i == sel;
            clicked => {
                root.sel = i;
                root.zone = 0;
                root.launch(i);
            }
        }
    }
    if tab == 0 && games.length == 0: Text {
        x: 80px;
        y: 600px;
        text: @tr("Ajoutez des jeux dans games.json (boutiques à venir).");
        font-size: 30px;
        color: Theme.dim;
    }

    // --- Onglet Boutique unifié : recherche, puis catalogue (toutes boutiques confondues) ---
    if tab == 1: Text {
        x: 80px;
        y: 200px;
        text: @tr("Boutique");
        font-size: 88px;
        font-weight: 800;
        color: Theme.text;
    }
    if tab == 1: Rectangle {
        x: 80px;
        y: 330px;
        width: 1100px;
        height: 92px;
        border-radius: 46px;
        background: zone == 0 && brow == 0 ? Theme.accent : Theme.glass;
        animate background { duration: 100ms; }
        Text {
            x: 36px;
            text: "\u{E721}";
            font-family: Theme.icons;
            font-size: 34px;
            color: Theme.text;
        }
        Text {
            x: 100px;
            width: parent.width - 130px;
            text: search-query == "" ? @tr("Rechercher un jeu…") : search-query;
            font-size: 32px;
            color: search-query == "" ? Theme.dim : Theme.text;
            overflow: elide;
        }
        TouchArea {
            clicked => { root.brow = 0; root.search-open(); }
        }
    }
    if tab == 1: Text {
        x: 80px;
        y: 470px;
        text: offers-title;
        font-size: 30px;
        font-weight: 600;
        color: Theme.text;
    }
    if tab == 1 && offers-state != "": Text {
        x: 80px;
        y: 560px;
        text: offers-state == "loading" ? @tr("Chargement…") : @tr("Aucune offre (réseau indisponible ?)");
        font-size: 28px;
        color: Theme.dim;
    }
    if tab == 1: Rectangle {
        x: 80px - max(0, osel - 6) * 268px;
        y: 540px;
        width: offers.length * 300px;
        height: 560px;
        animate x { duration: 150ms; easing: ease-out; }
        for o[i] in offers: Rectangle {
            property <bool> on: brow == 1 && zone == 0 && i == osel;
            x: i * 268px + (i > osel && brow == 1 ? 40px : 0px);
            y: on ? -16px : 0px;
            width: on ? 280px : 240px;
            height: on ? 420px : 360px;
            animate x, y, width, height { duration: 120ms; easing: ease-out; }
            Rectangle {
                height: parent.height - 76px;
                border-radius: 16px;
                clip: true;
                background: Theme.tile;
                Image {
                    width: 100%;
                    height: 100%;
                    source: o.art;
                    image-fit: cover;
                }
                Rectangle {
                    border-radius: 16px;
                    border-width: on ? 5px : 0px;
                    border-color: Theme.text;
                }
            }
            Text {
                y: parent.height - 66px;
                width: parent.width;
                text: o.title;
                font-size: 22px;
                font-weight: 600;
                color: on ? Theme.text : Theme.dim;
                overflow: elide;
            }
            Text {
                y: parent.height - 34px;
                text: o.price + "  ·  " + o.store;
                font-size: 22px;
                color: Theme.accent;
            }
            TouchArea {
                clicked => { root.brow = 1; root.osel = i; root.show-offer(i); }
            }
        }
    }

    // --- Barre du haut : onglets à gauche, raccourcis système, profil et heure à droite ---
    for t[i] in [@tr("Jeux"), @tr("Boutique")]: Rectangle {
        x: 80px + i * 230px;
        y: 44px;
        width: 210px;
        height: 64px;
        border-radius: 32px;
        background: zone == 1 && top == i ? Theme.accent : transparent;
        animate background { duration: 100ms; }
        Text {
            text: t;
            font-size: 34px;
            font-weight: tab == i ? 700 : 400;
            color: tab == i ? Theme.text : Theme.dim;
        }
        if tab == i: Rectangle {
            y: parent.height - 6px;
            x: (parent.width - 60px) / 2;
            width: 60px;
            height: 4px;
            border-radius: 2px;
            background: Theme.text;
        }
        TouchArea {
            clicked => { root.tab = i; root.top = i; root.zone = 0; }
        }
    }
    HorizontalLayout {
        x: 0px;
        y: 40px;
        width: parent.width - 80px;
        height: 72px;
        alignment: end;
        spacing: 28px;
        for g[i] in ["bell", "\u{E713}", "\u{E7E8}"]: TopIcon {
            glyph: g;
            badge: i == 0 ? unread : 0;
            selected: zone == 1 && top == i + 2;
        }
        Rectangle {
            width: 20px;
        }
        Rectangle {
            width: 72px;
            height: 72px;
            border-radius: 36px;
            background: Theme.glass;
            Text {
                text: "\u{E77B}";
                font-family: Theme.icons;
                font-size: 28px;
                color: Theme.text;
            }
        }
        Text {
            text: user;
            font-size: 28px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: "\u{E701}";
            font-family: Theme.icons;
            font-size: 28px;
            color: Theme.text;
            vertical-alignment: center;
        }
        Text {
            text: clock;
            font-size: 28px;
            color: Theme.text;
            vertical-alignment: center;
        }
    }

    // --- Pictogrammes de la manette ---
    HorizontalLayout {
        x: 80px;
        y: parent.height - 100px;
        spacing: 48px;
        Hint { btn: 0; label: @tr("Valider"); }
        Hint { btn: 1; label: @tr("Retour"); }
        Hint { btn: 2; label: @tr("Menu"); }
    }

    if zone == 2: Rectangle {
        background: #000a;
        TouchArea { }
        Rectangle {
            width: 460px;
            height: 5 * 76px + 32px;
            border-radius: 20px;
            background: Theme.panel;
            for item[i] in [@tr("Mettre en veille"), @tr("Redémarrer"), @tr("Éteindre"), @tr("Bureau Windows"), @tr("Annuler")]: Rectangle {
                x: 16px;
                y: 16px + i * 76px;
                width: parent.width - 32px;
                height: 68px;
                border-radius: 14px;
                background: i == pw ? Theme.accent : transparent;
                Text {
                    x: 24px;
                    text: item;
                    font-size: 28px;
                    color: Theme.text;
                }
                TouchArea {
                    clicked => {
                        root.pw = i;
                        root.nav(4);
                    }
                }
            }
        }
    }

    if zone == 3: Rectangle {
        background: Theme.bg-settings;
        TouchArea { }
        Text {
            x: 80px;
            y: 100px;
            text: @tr("Réglages");
            font-size: 96px;
            font-weight: 800;
            color: Theme.text;
        }
        for c[i] in cats: Rectangle {
            x: 80px;
            y: 270px + i * 84px;
            width: 440px;
            height: 72px;
            border-radius: 14px;
            background: i != cat ? transparent : sfocus == 0 ? Theme.accent : Theme.glass;
            animate background { duration: 100ms; }
            Text {
                x: 26px;
                text: ["\u{E767}", "\u{E7F4}", "\u{E701}", "\u{E702}", "\u{E7FC}", "\u{E774}", "\u{E895}", "\u{EDA2}", "\u{E950}", "\u{E7E8}", "\u{E7ED}", "\u{E946}", "\u{E77B}"][i];
                font-family: Theme.icons;
                font-size: 28px;
                color: i == cat ? Theme.text : Theme.dim;
            }
            Text {
                x: 84px;
                text: c;
                font-size: 28px;
                color: i == cat ? Theme.text : Theme.dim;
            }
            TouchArea {
                clicked => {
                    root.cat = i;
                    root.sfocus = 0;
                    root.srow = 0;
                    root.open-cat(i);
                }
            }
        }
        Rectangle {
            x: 580px;
            y: 300px;
            width: parent.width - 580px - 80px;
            height: min(rows.length, 8) * 104px + 24px;
            clip: true;
            border-radius: 18px;
            background: Theme.glass;
            for r[i] in rows: Rectangle {
                x: 12px;
                y: 12px + (i - max(0, srow - 7)) * 104px;
                width: parent.width - 24px;
                height: 96px;
                border-radius: 14px;
                background: sfocus == 1 && i == srow ? Theme.accent : transparent;
                animate background { duration: 100ms; }
                Text {
                    x: 32px;
                    text: r.label;
                    font-size: 28px;
                    color: Theme.text;
                }
                Text {
                    x: parent.width - self.width - 32px;
                    text: r.adjustable ? "‹  " + r.value + "  ›" : r.value;
                    font-size: 28px;
                    color: sfocus == 1 && i == srow ? Theme.text : Theme.dim;
                }
                TouchArea {
                    clicked => {
                        root.sfocus = 1;
                        root.srow = i;
                        root.setting(root.cat, i, 0);
                    }
                }
            }
        }
        Text {
            x: 580px;
            y: 300px + min(rows.length, 8) * 104px + 56px;
            text: shint;
            font-size: 24px;
            color: Theme.text;
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Valider"); }
            Hint { btn: 1; label: @tr("Retour"); }
        }
    }

    // Toast : dernière notification, quelques secondes en haut à droite.
    Rectangle {
        x: parent.width - 700px - 60px + (toast-on ? 0px : 760px);
        y: 140px;
        width: 700px;
        height: 120px;
        border-radius: 18px;
        background: #1b2142f2;
        opacity: toast-on ? 1 : 0;
        animate x, opacity { duration: 220ms; easing: ease-out; }
        Rectangle {
            x: 20px;
            y: 26px;
            width: 68px;
            height: 68px;
            border-radius: 34px;
            background: Theme.accent;
            Text {
                text: "\u{E7ED}";
                font-family: Theme.icons;
                font-size: 30px;
                color: Theme.text;
            }
        }
        Text {
            x: 108px;
            y: 24px;
            width: parent.width - 128px;
            text: toast-title;
            font-size: 26px;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: 108px;
            y: 62px;
            width: parent.width - 128px;
            text: toast-text;
            font-size: 22px;
            color: Theme.dim;
            overflow: elide;
        }
    }

    // Centre de notifications.
    if zone == 8: Rectangle {
        background: #000a;
        TouchArea { }
        Rectangle {
            x: parent.width - 900px;
            width: 900px;
            background: Theme.bg-guide;
            Text {
                x: 48px;
                y: 60px;
                text: @tr("Notifications");
                font-size: 56px;
                font-weight: 800;
                color: Theme.text;
            }
            if notifs.length == 0: Text {
                x: 48px;
                y: 200px;
                text: @tr("Aucune notification");
                font-size: 28px;
                color: Theme.dim;
            }
            for n[i] in notifs: Rectangle {
                x: 36px;
                y: 170px + i * 130px;
                width: parent.width - 72px;
                height: 118px;
                border-radius: 16px;
                background: i == nsel ? Theme.accent : #ffffff14;
                animate background { duration: 100ms; }
                if n.unread: Rectangle {
                    x: 14px;
                    y: 14px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: #ff5b5b;
                }
                Text {
                    x: 40px;
                    y: 18px;
                    width: parent.width - 200px;
                    text: n.title;
                    font-size: 26px;
                    font-weight: 700;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    x: parent.width - self.width - 24px;
                    y: 22px;
                    text: n.time;
                    font-size: 20px;
                    color: i == nsel ? Theme.text : Theme.dim;
                }
                Text {
                    x: 40px;
                    y: 62px;
                    width: parent.width - 64px;
                    text: n.text;
                    font-size: 22px;
                    color: i == nsel ? Theme.text : Theme.dim;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                x: 48px;
                y: parent.height - 100px;
                spacing: 36px;
                Hint { btn: 0; label: @tr("Effacer"); }
                Hint { btn: 3; label: @tr("Tout effacer"); }
                Hint { btn: 1; label: @tr("Retour"); }
            }
        }
    }

    // Sélecteur générique (explorateur de fichiers, identification d'un jeu…).
    if zone == 6: Rectangle {
        background: #0b0e24;
        TouchArea { }
        Text {
            x: 120px;
            y: 80px;
            width: parent.width - 240px;
            text: pick-title;
            font-size: 56px;
            font-weight: 800;
            color: Theme.text;
            overflow: elide;
        }
        Text {
            x: 120px;
            y: 170px;
            width: parent.width - 240px;
            text: pick-hint;
            font-size: 24px;
            color: Theme.dim;
            overflow: elide;
        }
        for it[i] in pick-items: Rectangle {
            property <int> pos: i - max(0, psel - 8);
            visible: pos >= 0 && pos < 9;
            x: 120px;
            y: 230px + pos * 108px;
            width: parent.width - 240px;
            height: 96px;
            border-radius: 16px;
            background: i == psel ? Theme.accent : #ffffff14;
            Rectangle {
                x: 12px;
                y: 8px;
                width: 80px;
                height: 80px;
                border-radius: 12px;
                clip: true;
                background: #ffffff22;
                Image {
                    width: 100%;
                    height: 100%;
                    source: it.art;
                    image-fit: cover;
                }
                if it.art.width == 0: Text {
                    text: it.glyph;
                    font-family: Theme.icons;
                    font-size: 36px;
                    color: Theme.text;
                }
            }
            Text {
                x: 116px;
                y: it.sub == "" ? 32px : 16px;
                width: parent.width - 140px;
                text: it.label;
                font-size: 30px;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            if it.sub != "": Text {
                x: 116px;
                y: 56px;
                width: parent.width - 140px;
                text: it.sub;
                font-size: 22px;
                color: i == psel ? Theme.text : Theme.dim;
                overflow: elide;
            }
        }
        HorizontalLayout {
            x: 120px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 0; label: @tr("Valider"); }
            Hint { btn: 1; label: @tr("Retour"); }
        }
    }

    // QR code d'achat : à scanner avec un téléphone.
    if zone == 5: Rectangle {
        background: #0b0e24ee;
        TouchArea { }
        Text {
            x: (parent.width - self.width) / 2;
            y: 140px;
            text: qr-title;
            font-size: 44px;
            font-weight: 700;
            color: Theme.text;
        }
        Rectangle {
            x: (parent.width - 560px) / 2;
            y: 250px;
            width: 560px;
            height: 560px;
            border-radius: 20px;
            background: #ffffff;
            Image {
                width: 520px;
                height: 520px;
                source: qr;
                image-rendering: pixelated;
            }
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 850px;
            text: qr-hint;
            font-size: 32px;
            color: Theme.text;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 910px;
            text: qr-url;
            font-size: 22px;
            color: Theme.dim;
        }
        if qr-action != "": Rectangle {
            x: (parent.width - 420px) / 2;
            y: 980px;
            width: 420px;
            height: 84px;
            border-radius: 42px;
            background: Theme.accent;
            Text {
                text: qr-action;
                font-size: 30px;
                font-weight: 600;
                color: Theme.text;
            }
        }
        HorizontalLayout {
            x: 80px;
            y: parent.height - 100px;
            spacing: 48px;
            Hint { btn: 1; label: @tr("Retour"); }
        }
    }

    // Clavier virtuel (mots de passe, saisies).
    if zone == 4: Rectangle {
        background: #0b0e24ee;
        TouchArea { }
        Text {
            x: (parent.width - self.width) / 2;
            y: 180px;
            text: kb-title;
            font-size: 40px;
            font-weight: 700;
            color: Theme.text;
        }
        Rectangle {
            x: (parent.width - 1100px) / 2;
            y: 280px;
            width: 1100px;
            height: 90px;
            border-radius: 14px;
            background: Theme.glass;
            Text {
                x: 28px;
                text: kb-text + "▏";
                font-size: 34px;
                color: Theme.text;
            }
        }
        for k[i] in kb-keys: Rectangle {
            x: (parent.width - 1100px) / 2 + mod(i, 10) * 110px;
            y: 410px + floor(i / 10) * 100px;
            width: 100px;
            height: 90px;
            border-radius: 14px;
            background: kbx == mod(i, 10) && kby == floor(i / 10) ? Theme.accent : Theme.glass;
            Text {
                text: k;
                font-size: 34px;
                color: Theme.text;
            }
        }
        for lbl[i] in [@tr("Maj"), @tr("Espace"), @tr("Effacer"), @tr("Valider"), @tr("Annuler")]: Rectangle {
            x: (parent.width - 1100px) / 2 + i * 220px;
            y: 410px + 4 * 100px;
            width: 210px;
            height: 90px;
            border-radius: 14px;
            background: kbx == i && kby == 4 ? Theme.accent : Theme.glass;
            Text {
                text: lbl;
                font-size: 28px;
                color: Theme.text;
            }
        }
    }
}

// Ligne du menu en jeu : pastille d'icône, libellé, valeur et éventuelle jauge.
component GuideRow inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <string> value;
    in property <int> gauge: -1; // 0..100, -1 = pas de jauge
    in property <bool> selected;
    callback clicked;
    height: 76px;
    border-radius: 16px;
    background: selected ? Theme.accent : #ffffff14;
    animate background { duration: 100ms; }
    Rectangle {
        x: 14px;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: #ffffff26;
        Text {
            text: glyph;
            font-family: Theme.icons;
            font-size: 24px;
            color: Theme.text;
        }
    }
    Text {
        x: 78px;
        y: gauge >= 0 ? 10px : (parent.height - self.height) / 2;
        text: label;
        font-size: 24px;
        color: Theme.text;
    }
    Text {
        x: parent.width - self.width - 20px;
        y: gauge >= 0 ? 10px : (parent.height - self.height) / 2;
        text: value;
        font-size: 22px;
        color: selected ? Theme.text : Theme.dim;
    }
    if gauge >= 0: Rectangle {
        x: 78px;
        y: 50px;
        width: parent.width - 78px - 20px;
        height: 8px;
        border-radius: 4px;
        background: #ffffff33;
        Rectangle {
            width: parent.width * gauge / 100;
            border-radius: 4px;
            background: Theme.text;
        }
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

// Menu guide : panneau latéral affiché par-dessus le jeu.
export component GuideMenu inherits Window {
    in property <string> game;
    in property <image> art;
    in property <bool> closing;
    in property <int> volume: -1; // %, -1 = indisponible
    in property <int> brightness: -1;
    in property <int> wifi: -1; // -1 indisponible, 0 coupé, 1 actif
    in property <[string]> notes;
    in-out property <int> sel: 0;
    // item (0 reprendre, 1 accueil, 2 fermer, 3 volume, 4 luminosité, 5 wifi ; -1 = fermer le menu),
    // delta : 0 valider, -1/+1 gauche/droite
    callback action(int, int);

    title: "Hearth Guide";
    no-frame: true;
    always-on-top: true;
    background: #1c1650;
    forward-focus: keys;

    public function nav(a: int) {
        if (a == 0) { sel = max(0, sel - 1); }
        else if (a == 1) { sel = min(5, sel + 1); }
        else if (a == 2) { action(sel, -1); }
        else if (a == 3) { action(sel, 1); }
        else if (a == 4) { action(sel, 0); }
        else if (a == 5 || a == 6) { action(-1, 0); }
    }

    keys := NavKeys {
        nav(a) => { root.nav(a); }
    }

    Rectangle {
        background: Theme.bg-guide;
    }
    // En-tête : visuel du jeu + nom.
    Rectangle {
        x: 28px;
        y: 28px;
        width: 92px;
        height: 92px;
        border-radius: 16px;
        clip: true;
        background: Theme.tile;
        Image {
            width: 100%;
            height: 100%;
            source: art;
            image-fit: cover;
        }
    }
    Text {
        x: 140px;
        y: 34px;
        width: parent.width - 140px - 28px;
        text: game;
        font-size: 28px;
        font-weight: 700;
        color: Theme.text;
        wrap: word-wrap;
    }
    Text {
        x: 140px;
        y: 96px;
        text: @tr("En cours");
        font-size: 20px;
        color: Theme.dim;
    }
    VerticalLayout {
        x: 28px;
        y: 150px;
        width: parent.width - 56px;
        spacing: 10px;
        GuideRow {
            glyph: "\u{E768}";
            label: @tr("Reprendre");
            selected: sel == 0;
            clicked => { root.sel = 0; root.action(0, 0); }
        }
        GuideRow {
            glyph: "\u{E80F}";
            label: @tr("Accueil");
            selected: sel == 1;
            clicked => { root.sel = 1; root.action(1, 0); }
        }
        GuideRow {
            glyph: "\u{E711}";
            label: closing ? @tr("Forcer la fermeture") : @tr("Fermer le jeu");
            selected: sel == 2;
            clicked => { root.sel = 2; root.action(2, 0); }
        }
        GuideRow {
            height: 84px;
            glyph: "\u{E767}";
            label: @tr("Volume");
            value: volume < 0 ? "—" : volume + " %";
            gauge: volume;
            selected: sel == 3;
        }
        GuideRow {
            height: 84px;
            glyph: "\u{E706}";
            label: @tr("Luminosité");
            value: brightness < 0 ? "—" : brightness + " %";
            gauge: brightness;
            selected: sel == 4;
        }
        GuideRow {
            glyph: "\u{E701}";
            label: @tr("Wi-Fi");
            value: wifi < 0 ? "—" : wifi == 1 ? @tr("activé") : @tr("coupé");
            selected: sel == 5;
            clicked => { root.sel = 5; root.action(5, 0); }
        }
    }
    // Notifications.
    Rectangle {
        x: 28px;
        y: parent.height - 480px;
        width: parent.width - 56px;
        height: 340px;
        border-radius: 16px;
        background: #ffffff14;
        clip: true;
        Text {
            x: 20px;
            y: 16px;
            text: @tr("Notifications");
            font-size: 20px;
            color: Theme.dim;
        }
        VerticalLayout {
            x: 20px;
            y: 52px;
            width: parent.width - 40px;
            spacing: 8px;
            for n in notes: Text {
                text: n;
                font-size: 18px;
                color: Theme.text;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        x: 28px;
        y: parent.height - 100px;
        spacing: 28px;
        Hint { btn: 0; label: @tr("Valider"); }
        Hint { btn: 1; label: @tr("Retour"); }
    }
}

// Écran de lancement : fenêtre superposée au jeu pendant son chargement (comme le menu guide, sans prendre le focus).
export component Splash inherits Window {
    in property <string> launch-name;
    in property <image> launch-cover;
    in property <image> launch-art;
    in property <float> launch-t: 0; // 0..1 : progression de l'animation d'entrée
    in property <float> launch-spin: 0; // degrés
    title: "Hearth Splash";
    no-frame: true;
    always-on-top: true;
    background: #0a0c1e;
        TouchArea { }
        if launch-art.width > 0: Image {
            x: -(parent.width * (0.06 - 0.06 * launch-t)) / 2;
            y: -(parent.height * (0.06 - 0.06 * launch-t)) / 2;
            width: parent.width * (1.06 - 0.06 * launch-t);
            height: parent.height * (1.06 - 0.06 * launch-t);
            source: launch-art;
            image-fit: cover;
            opacity: 0.55 * launch-t;
        }
        Rectangle {
            background: @linear-gradient(180deg, #0a0c1e00 0%, #0a0c1ee0 100%);
        }
        Rectangle {
            x: (parent.width - 520px) / 2;
            y: 150px - 30px * (1 - launch-t);
            width: 520px;
            height: 640px;
            border-radius: 28px;
            clip: true;
            opacity: launch-t;
            background: Theme.tile;
            Image {
                width: 100%;
                height: 100%;
                source: launch-cover;
                image-fit: cover;
            }
            if launch-cover.width == 0: Text {
                text: launch-name;
                font-size: 48px;
                font-weight: 800;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                width: parent.width - 60px;
            }
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 830px;
            text: launch-name;
            font-size: 52px;
            font-weight: 800;
            color: Theme.text;
            opacity: launch-t;
        }
        // Anneau de chargement : huit points qui s'estompent en tournant.
        for i in [0, 1, 2, 3, 4, 5, 6, 7]: Rectangle {
            x: parent.width / 2 - 8px + 40px * cos(i * 45deg);
            y: 975px - 8px + 40px * sin(i * 45deg);
            width: 16px;
            height: 16px;
            border-radius: 8px;
            background: #ffffff;
            opacity: 1 - mod(launch-spin / 45 - i + 16, 8) / 8;
        }
        Text {
            x: (parent.width - self.width) / 2;
            y: 1050px;
            text: @tr("Lancement…");
            font-size: 26px;
            color: Theme.dim;
            opacity: launch-t;
        }
}
